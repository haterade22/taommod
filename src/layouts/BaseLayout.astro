---
import CookieNotice from '../components/CookieNotice.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Topbar from '../components/Topbar.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  hideNav?: boolean;
  hideFooter?: boolean;
  bodyClass?: string;
  mainClass?: string;
  /** Link-preview image (site-relative path). Defaults to the TAOM logo banner (1024×576). */
  image?: string;
  noindex?: boolean;
  /** Picture the page shows first from CSS (e.g. its hero background): loaded early so it appears sooner. */
  preloadImage?: string;
  /** Site path of the main version of this page, when the same content is reachable under another address. */
  canonicalPath?: string;
}

const { title, description = 'TAOM - Tales From the Age of Men - A total conversion mod for Bannerlord II' } =
  Astro.props;
const {
  hideNav = false,
  bodyClass,
  mainClass,
  image = '/images/og-banner.jpg',
  noindex = false,
  preloadImage,
  canonicalPath,
} = Astro.props;
// Pages that hide this nav render the Topbar and their own <main>; a second <main> around it is invalid.
const MainTag = hideNav ? 'div' : 'main';

const pageTitle = `${title} | TAOM`;
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TAOM - Tales From the Age of Men" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    {
      image === '/images/og-banner.jpg' && (
        <>
          <meta property="og:image:width" content="1024" />
          <meta property="og:image:height" content="576" />
          <meta property="og:image:alt" content="Tales from the Age of Men" />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="theme-color" content="#0d0908" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/cinzel-latin.woff2" as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" href={preloadImage} as="image" fetchpriority="high" />}
    <ClientRouter />
    <!-- Without JavaScript there is no pager, so show every table row (global.css shows only the first rows until
         the pager has run). -->
    <noscript
      ><style>
        .data-table-wrapper tbody tr {
          display: table-row !important;
        }
      </style></noscript
    >
  </head>
  <body class={bodyClass}>
    <!-- Every page uses the same gold top bar; pages with hideNav render it themselves inside their own wrapper. -->
    {!hideNav && <Topbar />}

    <MainTag class={mainClass}>
      <slot />
    </MainTag>

    <CookieNotice />
    <SiteFooter />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
