    <!-- ==================== SPIDER MOUNT ==================== -->
    <!-- Giant spider mount items (Mirkwood / Dol Guldur). Three visual variants
         matching compiled material tpacs (m_mordor_spider_a1/a2/a3_mtl.tpac).
         Mesh: sk_spider_forest_c (62-bone skeleton, see monsters.xml id="spider").
         Bound to Monster.spider with rider_sit_bone="chest_m" and Mountable="true".
         Pattern mirrors Alliance.Wargs/Items/LOTR/lotr_warg.xml. -->
    <Item id="spider_mount_a1"
        name="{=spider_mount_a1_name}[Mirkwood] Giant Spider"
        mesh="sk_spider_forest_bm_a1"
        subtype="horse"
        item_category="war_horse"
        culture="Culture.dolguldur"
        is_merchandise="true"
        value="1500"
        weight="600"
        difficulty="30"
        appearance="1"
        Type="Horse">
        <ItemComponent>
            <Horse
                monster="Monster.spider"
                maneuver="65"
                speed="45"
                charge_damage="5"
                body_length="130"
                is_mountable="true">
                <Materials>
                    <Material name="m_mordor_spider_a1" />
                </Materials>
            </Horse>
        </ItemComponent>
    </Item>

