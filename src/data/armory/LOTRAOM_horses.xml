    <!-- Mount item for the Giant Spider (taom_spider_creature goblin rider).
         is_merchandise="false" + no culture → never sold, never shown in party icon path.
         Mountable via horse-slot pattern (same as taom_war_elephant): goblin rider has
         equipment slot="Horse" id="Item.spider_mount_a"; engine spawns spider via Monster.spider.
         See lotr_monster_spider.xml (Mountable="true", rider_sit_bone="chest_m"). -->
    <Item
        id="spider_mount_a"
        name="{=spider_mount_a}Giant Spider"
        mesh="sk_spider_forest_c"
        subtype="horse"
        item_category="war_horse"
        weight="250"
        is_merchandise="false"
        Type="Horse">
        <ItemComponent>
            <Horse
                monster="Monster.spider"
                maneuver="60"
                speed="40"
                charge_damage="10"
                body_length="100"
                is_mountable="true">
                <!-- Right body half of the L/R mesh-split (warg-pattern AdditionalMeshes on HorseComponent);
                     base sk_spider_forest_c + this sk_spider_forest_c_2 draw as one creature. -->
                <AdditionalMeshes>
                    <Mesh
                        name="sk_spider_forest_c_2"
                        affected_by_cover="true" />
                </AdditionalMeshes>
            </Horse>
        </ItemComponent>
    </Item>
