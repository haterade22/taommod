    <!-- War chariot (Rhûn Wainriders — ROT 8.0 port, issue #279; provenance docs/features/chariot.md).
         Horse-slot vehicle for wainrider_swift_chariot / wainrider_warlord_chariot (troops_rhun_new.xml).
         Engine spawns Monster.chariot (lotr_monster_chariot.xml — 60-bone chariot_skeleton).
         Mesh = chariot_horse_brown — a SINGLE mesh containing BOTH horses (54 active bones; merged
         2026-06-13). The earlier per-horse split (chariot_horse_brown + _2) was REVERTED: a second
         full-horse mesh in the AdditionalMesh slot does not render (only the base mesh draws). The
         "~40 per-draw bone limit" that motivated the split is FALSE — the elephant renders as one
         mesh skinned to 59 active bones, so 54 in one mesh is safe. Cart + harness + mane ride along
         as AdditionalMeshes. chariot_ride (NOT chariot_ride_alt — alt's material has dead texture
         refs in ROT itself). is_merchandise="false" + no culture → never sold (spider_mount_a
         convention). Horse params 1-for-1 from ROT items.xml chariot1. See docs/features/chariot.md. -->
    <Item
        id="taom_chariot_a"
        name="{=taom_chariot_a}Wainrider War Chariot"
        mesh="chariot_horse_brown"
        subtype="horse"
        item_category="war_horse"
        weight="370"
        difficulty="120"
        is_merchandise="false"
        Type="Horse">
        <ItemComponent>
            <Horse
                monster="Monster.chariot"
                maneuver="25"
                speed="55"
                charge_damage="200"
                body_length="100"
                is_mountable="true">
                <AdditionalMeshes>
                    <Mesh name="chariot_horse_brown_mane" affected_by_cover="true" />
                    <Mesh name="chariot_harness_e_rein" affected_by_cover="true" />
                    <Mesh name="chariot_ride" affected_by_cover="false" />
                </AdditionalMeshes>
            </Horse>
        </ItemComponent>
        <Flags Civilian="true" />
    </Item>

