---
// The Features page. Its cards live in src/data/features.json (hand-written from the mod's code and the team's
// Discord posts); the special resource tables are read from the mod's own files (src/lib/parse-special-resources.ts).
// A switch at the top shows either the public build (Bannerlord 1.4.8) or the supporter/tester build (1.5): a card
// with "only": "supporter" is hidden in the public view, and a card's "public" fields replace its own there.
import Topbar from '../../components/Topbar.astro';
import features from '../../data/features.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { parseSpecialResources, type Build } from '../../lib/parse-special-resources';

interface Setting {
  name: string;
  default: string;
}

interface CardText {
  title: string;
  summary: string;
  points?: string[];
  settings?: Setting[];
  new?: string;
  link?: { href: string; label: string };
}

interface Card extends CardText {
  only?: Build;
  /** In the development code but in no release yet: shown only in the Coming soon section. */
  coming?: boolean;
  public?: Partial<CardText>;
}

interface Section {
  id: string;
  title: string;
  intro: string;
  cards: Card[];
}

const BUILDS: Build[] = ['public', 'supporter'];
const builds = features.builds as Record<
  Build,
  { label: string; game: string; modVersion: string; released: string; careerCount: number; modOptionsCount: string }
>;
const sections = features.sections as Section[];

/** One card as it reads in one build, or null when the build does not have it. */
const cardIn = (card: Card, build: Build): CardText | null =>
  card.coming || (card.only && card.only !== build)
    ? null
    : build === 'public' && card.public
      ? { ...card, ...card.public }
      : card;

/** The versions of a card to render: one when both builds read the same, else one per build. */
const versionsOf = (card: Card): { build?: Build; text: CardText }[] =>
  card.only
    ? [{ build: card.only, text: card }]
    : card.public
      ? BUILDS.map((build) => ({ build, text: cardIn(card, build)! }))
      : [{ text: card }];

const featureCount = (build: Build) =>
  sections.reduce((sum, section) => sum + section.cards.filter((card) => cardIn(card, build)).length, 0);
const supporterExtra = featureCount('supporter') - featureCount('public');
const comingCards = sections.flatMap((section) =>
  section.cards.filter((card) => card.coming).map((card) => ({ area: section.title, card })),
);
const tables = Object.fromEntries(BUILDS.map((build) => [build, parseSpecialResources(build)])) as Record<
  Build,
  ReturnType<typeof parseSpecialResources>
>;

const settingClass = (value: string) =>
  value === 'On' ? 'setting-on' : value === 'Off' ? 'setting-off' : 'setting-value';
const fmt = (value?: number) => (value === undefined ? '' : String(value));
const date = (iso: string) =>
  new Date(`${iso}T12:00:00Z`).toLocaleDateString('en-GB', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<BaseLayout
  title="Features"
  description="Every gameplay system in TAOM, for the public build (Bannerlord 1.4.8) and the supporter build (Bannerlord 1.5): the War of the Ring, careers, enlistment, special resources, creatures, battle and more."
  hideNav={true}
  hideFooter={true}
  bodyClass="taom-features-body"
  mainClass="taom-features-main"
>
  <div class="features-page" data-build="public" data-features-page>
    <script is:inline>
      // Pick the build before the page draws, so it never flashes the other one: ?build= in the address first,
      // then the visitor's last choice.
      (() => {
        const page = document.currentScript.parentElement;
        let build = new URLSearchParams(location.search).get('build');
        if (build !== 'public' && build !== 'supporter') {
          try {
            build = localStorage.getItem('taom-features-build');
          } catch {
            build = null;
          }
        }
        if (build === 'public' || build === 'supporter') page.dataset.build = build;
      })();
    </script>

    <div class="topbar-wrap">
      <Topbar />
    </div>

    <main class="features-shell">
      <section class="page-intro">
        <p class="eyebrow">What TAOM Adds</p>
        <h1>Features</h1>
        <p class="intro-copy">
          The systems that make TAOM's campaign, battles and world play differently from the base game. Most of them can
          be switched off or tuned in the game's Mod Options; the default for each is shown on its card.
        </p>
        <nav class="page-breadcrumb"><a href="/mod-info">Mod Info</a> / Features</nav>
      </section>

      <section class="build-panel" aria-label="Choose a build">
        <button class="build-switch" type="button" role="switch" aria-checked="false" data-build-switch>
          <span class="visually-hidden">Show the supporter build instead of the public build</span>
          {
            BUILDS.map((build) => (
              <span class="build-option" data-option={build} aria-hidden="true">
                <span class="build-name">{builds[build].label} build</span>
                <span class="build-game">{builds[build].game}</span>
              </span>
            ))
          }
        </button>
        <p class="build-note" data-build-only="public">
          The build everyone can download: TAOM {builds.public.modVersion}, released {date(builds.public.released)}. The
          supporter build has {supporterExtra} more features; switch above to see them.
        </p>
        <p class="build-note" data-build-only="supporter">
          The build for supporters and testers: TAOM {builds.supporter.modVersion}, released {
            date(builds.supporter.released)
          }. Cards marked <span class="status-badge supporter-badge">Supporter build</span> are not in the public build yet.
        </p>
      </section>

      {
        BUILDS.map((build) => (
          <section class="features-summary" aria-label="Features page summary" data-build-only={build}>
            <article class="summary-card">
              <span class="summary-label">Feature Areas</span>
              <strong>{sections.length}</strong>
            </article>
            <article class="summary-card">
              <span class="summary-label">Features</span>
              <strong>{featureCount(build)}</strong>
            </article>
            <article class="summary-card">
              <span class="summary-label">Careers</span>
              <strong>{builds[build].careerCount}</strong>
            </article>
            <article class="summary-card">
              <span class="summary-label">Mod Options</span>
              <strong>{builds[build].modOptionsCount}</strong>
            </article>
          </section>
        ))
      }

      <section class="features-toolbar" aria-label="Find a feature">
        <nav class="section-links" aria-label="Feature areas">
          {sections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}
          {
            comingCards.length > 0 && (
              <a class="coming-link" href="#coming-soon">
                Coming soon
              </a>
            )
          }
        </nav>
        <label class="feature-search">
          <span class="visually-hidden">Search features</span>
          <input type="search" placeholder="Search features…" autocomplete="off" data-feature-search />
        </label>
        <p class="search-empty" hidden data-search-empty>No feature matches that search.</p>
      </section>

      <div class="category-stack">
        {
          sections.map((section) => (
            <section class="section-block" id={section.id} data-feature-section>
              <div class="section-heading">
                <h2>{section.title}</h2>
                <p class="section-copy">{section.intro}</p>
              </div>

              <div class="features-grid">
                {section.cards
                  .filter((card) => !card.coming)
                  .flatMap((card) =>
                    versionsOf(card).map(({ build, text }) => (
                      <article class="feature-card" data-feature-card data-build-only={build}>
                        <div class="feature-header">
                          <h3>{text.title}</h3>
                          {card.only === 'supporter' && (
                            <span class="status-badge supporter-badge">Supporter build</span>
                          )}
                          {text.new && <span class="status-badge">New in {text.new}</span>}
                        </div>

                        <p class="feature-desc">{text.summary}</p>

                        {text.points && text.points.length > 0 && (
                          <ul class="feature-details">
                            {text.points.map((point) => (
                              <li>{point}</li>
                            ))}
                          </ul>
                        )}

                        {text.link && (
                          <a class="feature-link" href={text.link.href}>
                            {text.link.label} →
                          </a>
                        )}

                        {text.settings && text.settings.length > 0 && (
                          <div class="setting-chips">
                            <span class="setting-label">Mod Options</span>
                            {text.settings.map((setting) => (
                              <span class:list={['setting-chip', settingClass(setting.default)]}>
                                {setting.name}: {setting.default}
                              </span>
                            ))}
                          </div>
                        )}
                      </article>
                    )),
                  )}
              </div>

              {section.id === 'armies' &&
                BUILDS.filter((build) => tables[build].resources.length > 0).map((build) => (
                  <div class="resource-tables" data-feature-card data-build-only={build}>
                    <h3>Special resources</h3>
                    <p class="table-note">
                      What each realm earns in the {builds[build].label.toLowerCase()} build. "Daily" is per town held;
                      the others are per event.
                    </p>
                    <div class="data-table-wrapper resource-wrapper">
                      <table class="resource-table">
                        <thead>
                          <tr>
                            <th scope="col">Resource</th>
                            <th scope="col">Realms</th>
                            <th scope="col">Daily</th>
                            <th scope="col">Battle won</th>
                            <th scope="col">Raid</th>
                            <th scope="col">Siege won</th>
                            <th scope="col">Prisoner</th>
                            <th scope="col">Tournament</th>
                            <th scope="col">Hideout</th>
                          </tr>
                        </thead>
                        <tbody>
                          {tables[build].resources.map((r) => (
                            <tr>
                              <th scope="row">{r.name}</th>
                              <td class="realms">{r.realms.join(', ')}</td>
                              <td>{r.dailyPerTown}</td>
                              <td>{r.battle}</td>
                              <td>{r.raid}</td>
                              <td>{r.siege}</td>
                              <td>{r.prisoner}</td>
                              <td>{r.tournament}</td>
                              <td>{r.hideout}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>

                    <h3>Elite troops and their price</h3>
                    <p class="table-note">
                      <strong>Buy</strong> is the price at the emissary in{' '}
                      {tables[build].emissaryTowns.map((t) => t.name).join(', ')}. <strong>Upgrade</strong> is the price
                      to upgrade into the troop on the party screen, <strong>Recruit</strong> a one-time charge when it
                      joins another way (as a volunteer or from your prisoners), and <strong>Upkeep</strong> what each
                      soldier costs per day. A blank means none.
                    </p>
                    {tables[build].troopsByResource.map((group) => (
                      <details class="troop-group">
                        <summary>
                          {group.resource.name}
                          <span class="troop-count">
                            {group.resource.realms.join(', ')} · {group.troops.length} troops
                          </span>
                        </summary>
                        <div class="data-table-wrapper resource-wrapper">
                          <table class="resource-table">
                            <thead>
                              <tr>
                                <th scope="col">Troop</th>
                                <th scope="col">Realm</th>
                                <th scope="col">Buy</th>
                                <th scope="col">Upgrade</th>
                                <th scope="col">Recruit</th>
                                <th scope="col">Upkeep</th>
                              </tr>
                            </thead>
                            <tbody>
                              {group.troops.map((t) => (
                                <tr>
                                  <th scope="row">{t.name}</th>
                                  <td class="realms">{t.realm ?? ''}</td>
                                  <td>{fmt(t.buy)}</td>
                                  <td>{fmt(t.upgrade)}</td>
                                  <td>{fmt(t.recruit)}</td>
                                  <td>{fmt(t.upkeep)}</td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      </details>
                    ))}
                  </div>
                ))}
            </section>
          ))
        }
      </div>

      {
        comingCards.length > 0 && (
          <section class="section-block coming-block" id="coming-soon" data-feature-section>
            <div class="section-heading">
              <div>
                <p class="coming-kicker">In development</p>
                <h2>Coming soon</h2>
              </div>
              <p class="section-copy">
                Not in any release yet, so neither build has these. They may change or never be released.
              </p>
            </div>
            <div class="features-grid">
              {comingCards.map(({ area, card }) => (
                <article class="feature-card coming-card" data-feature-card>
                  <div class="feature-header">
                    <h3>{card.title}</h3>
                    <span class="status-badge coming-badge">Coming soon</span>
                  </div>
                  <p class="coming-area">{area}</p>
                  <p class="feature-desc">{card.summary}</p>
                  {card.points && card.points.length > 0 && (
                    <ul class="feature-details">
                      {card.points.map((point) => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  )}
                </article>
              ))}
            </div>
          </section>
        )
      }
    </main>
  </div>
</BaseLayout>

<script>
  // The build switch, and the search: it hides cards (and whole sections) that do not contain every word typed, and
  // cards of the other build.
  function initFeatures() {
    const page = document.querySelector<HTMLElement>('[data-features-page]');
    const input = document.querySelector<HTMLInputElement>('[data-feature-search]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-build-switch]');
    if (!page || !input || !toggle || page.dataset.ready) return;
    page.dataset.ready = 'true';
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-feature-section]'));
    const empty = document.querySelector<HTMLElement>('[data-search-empty]');
    const cards = sections.map((section) =>
      Array.from(section.querySelectorAll<HTMLElement>('[data-feature-card]')).map((card) => ({
        card,
        build: card.dataset.buildOnly,
        text: (card.textContent || '').toLowerCase(),
      })),
    );

    function filter() {
      const words = input!.value.toLowerCase().split(/\s+/).filter(Boolean);
      const build = page!.dataset.build;
      let shown = 0;
      sections.forEach((section, i) => {
        let sectionShown = 0;
        for (const { card, build: only, text } of cards[i]) {
          const match = words.every((word) => text.includes(word));
          card.hidden = !match;
          if (match && (!only || only === build)) sectionShown++;
        }
        section.hidden = sectionShown === 0;
        shown += sectionShown;
      });
      if (empty) empty.hidden = shown > 0;
    }

    function show(build: string) {
      page!.dataset.build = build;
      toggle!.setAttribute('aria-checked', String(build === 'supporter'));
      try {
        localStorage.setItem('taom-features-build', build);
      } catch {
        // Storage blocked: the choice just is not remembered.
      }
      const url = new URL(location.href);
      url.searchParams.set('build', build);
      history.replaceState(history.state, '', url);
      filter();
    }

    toggle.setAttribute('aria-checked', String(page.dataset.build === 'supporter'));
    toggle.addEventListener('click', () => show(page.dataset.build === 'supporter' ? 'public' : 'supporter'));
    input.addEventListener('input', filter);
    filter();
  }

  document.addEventListener('astro:page-load', initFeatures);
</script>

<style>
  :global(body.taom-features-body) {
    min-height: 100vh;
    background:
      linear-gradient(180deg, rgba(7, 5, 5, 0.74), rgba(7, 5, 5, 0.98)),
      radial-gradient(circle at 14% 12%, rgba(81, 134, 173, 0.14), transparent 24%),
      radial-gradient(circle at 84% 18%, rgba(138, 92, 58, 0.14), transparent 24%),
      linear-gradient(180deg, #15100f 0%, #0d0908 48%, #080606 100%);
    /* Gradients cover the top screen only, then the page continues in their last colour: stretched over
       the whole page they made Firefox redraw them while scrolling on large screens. */
    background-size: 100% 100vh;
    background-repeat: no-repeat;
    background-color: #080606;
    color: #ece4db;
  }

  :global(body.taom-features-body::before) {
    content: '';
    /* Scrolls with the page (a fixed full-screen layer made Firefox scrolling stutter). */
    position: absolute;
    inset: 0 0 auto;
    height: 100vh;
    background:
      linear-gradient(180deg, rgba(15, 10, 9, 0.36), rgba(8, 6, 6, 0.84)),
      url('/images/hero-bg.webp') center top / cover no-repeat;
    opacity: 0.13;
    pointer-events: none;
    z-index: -2;
  }

  :global(.taom-features-main) {
    display: block;
  }

  .features-page {
    min-height: 100vh;
    padding: 2rem 0.5rem;
    font-family: Georgia, 'Times New Roman', serif;
  }

  .topbar-wrap {
    width: 100%;
  }

  .features-shell {
    width: 100%;
    max-width: 84rem;
    margin: 0 auto;
    padding: 2.25rem 0.75rem 3.5rem;
    display: grid;
    /* minmax(0, 1fr): a wide table inside must scroll in its own box, not stretch the page. */
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .page-intro {
    display: grid;
    gap: 0.8rem;
    max-width: 56rem;
  }

  .eyebrow,
  .summary-label,
  .setting-label {
    font-family: 'Cinzel', 'Times New Roman', serif;
  }

  .eyebrow {
    color: #c19748;
    font-size: 0.86rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
  }

  .page-intro h1 {
    margin: 0;
    color: #f2ece4;
    font-family: 'Cinzel', 'Times New Roman', serif;
    font-size: clamp(3.7rem, 8vw, 6rem);
    line-height: 0.92;
    font-weight: 600;
    text-transform: uppercase;
  }

  .intro-copy {
    margin: 0;
    max-width: 49rem;
    color: rgba(238, 228, 219, 0.9);
    font-size: 1.18rem;
    line-height: 1.5;
  }

  .page-breadcrumb {
    margin: 0;
    color: rgba(214, 199, 176, 0.68);
    font-size: 0.88rem;
  }

  .page-breadcrumb a,
  .feature-link {
    color: #d7b26c;
    text-decoration: none;
  }

  .page-breadcrumb a:hover,
  .feature-link:hover {
    text-decoration: underline;
  }

  .features-summary {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.95rem;
  }

  .summary-card,
  .features-toolbar,
  .section-block {
    border: 1px solid rgba(120, 89, 38, 0.55);
    background: rgba(12, 10, 9, 0.935);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.28);
  }

  .summary-card {
    padding: 1.15rem 1.25rem;
    display: grid;
    gap: 0.45rem;
  }

  .summary-label {
    color: rgba(207, 182, 132, 0.85);
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .summary-card strong {
    color: #f6f0e6;
    font-family: 'Cinzel', 'Times New Roman', serif;
    font-size: 2.2rem;
    font-weight: 600;
    line-height: 1;
  }

  /* Jump links and search */
  .features-toolbar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 20rem);
    gap: 0.9rem 1.2rem;
    align-items: center;
    padding: 1rem 1.2rem;
  }

  .section-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .section-links a {
    padding: 0.35rem 0.7rem;
    border: 1px solid rgba(209, 154, 51, 0.3);
    color: #e2c27f;
    font-family: 'Cinzel', 'Times New Roman', serif;
    font-size: 0.82rem;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background 160ms ease;
  }

  .section-links a:hover {
    border-color: rgba(209, 154, 51, 0.7);
    background: rgba(209, 154, 51, 0.08);
  }

  .feature-search input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.6rem 0.8rem;
    border: 1px solid rgba(209, 154, 51, 0.4);
    background: rgba(0, 0, 0, 0.35);
    color: #f4ede3;
    font: inherit;
    font-size: 0.95rem;
  }

  .feature-search input:focus {
    outline: 2px solid rgba(209, 154, 51, 0.6);
    outline-offset: 1px;
  }

  .search-empty {
    grid-column: 1 / -1;
    margin: 0;
    color: rgba(224, 213, 198, 0.8);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* Build switch: one button, the active build lit. Cards and tables of the other build are hidden. */
  .features-page[data-build='public'] [data-build-only='supporter'],
  .features-page[data-build='supporter'] [data-build-only='public'] {
    display: none !important;
  }

  .build-panel {
    display: grid;
    gap: 0.7rem;
    justify-items: start;
  }

  .build-switch {
    display: inline-grid;
    grid-template-columns: 1fr 1fr;
    padding: 0.3rem;
    border: 1px solid rgba(209, 154, 51, 0.55);
    border-radius: 999px;
    background: rgba(12, 10, 9, 0.935);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.28);
    cursor: pointer;
    font: inherit;
  }

  .build-switch:focus-visible {
    outline: 2px solid #e7bd62;
    outline-offset: 3px;
  }

  .build-option {
    display: grid;
    gap: 0.1rem;
    padding: 0.55rem 1.4rem;
    border-radius: 999px;
    color: rgba(224, 213, 198, 0.62);
    text-align: center;
    transition:
      background 160ms ease,
      color 160ms ease;
  }

  .build-name {
    font-family: 'Cinzel', 'Times New Roman', serif;
    font-size: 1rem;
    font-weight: 600;
  }

  .build-game {
    font-size: 0.8rem;
  }

  .build-switch:hover .build-option {
    color: rgba(240, 230, 215, 0.85);
  }

  .features-page[data-build='public'] .build-option[data-option='public'],
  .features-page[data-build='supporter'] .build-option[data-option='supporter'] {
    background: linear-gradient(180deg, #d9a640, #b07d24);
    color: #160f08;
  }

  .build-note {
    margin: 0;
    max-width: 52rem;
    color: rgba(224, 213, 198, 0.82);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .supporter-badge {
    background: rgba(120, 160, 210, 0.16);
    color: #a9c7ea;
  }

  @media (max-width: 480px) {
    .build-switch {
      width: 100%;
    }

    .build-option {
      padding-inline: 0.6rem;
    }
  }
  /* Coming soon: dashed frame and its own colour so it never reads as a released feature. */
  .coming-block {
    border-style: dashed;
    border-color: rgba(190, 140, 220, 0.55);
    background: rgba(16, 11, 18, 0.935);
  }

  .coming-kicker {
    margin: 0 0 0.3rem;
    color: #c9a3e3;
    font-family: 'Cinzel', 'Times New Roman', serif;
    font-size: 0.82rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .coming-card {
    border-style: dashed;
    border-color: rgba(190, 140, 220, 0.3);
  }

  .coming-badge {
    background: rgba(190, 140, 220, 0.16);
    color: #d3b0ec;
  }

