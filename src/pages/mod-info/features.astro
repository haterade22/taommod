---
// The Features page. Its cards live in src/data/features.json (hand-written from the mod's code and the team's
// Discord posts); the special resource tables are read from the mod's own files (src/lib/parse-special-resources.ts).
import Topbar from '../../components/Topbar.astro';
import features from '../../data/features.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { parseSpecialResources } from '../../lib/parse-special-resources';

interface Setting {
  name: string;
  default: string;
}

interface Card {
  title: string;
  summary: string;
  points?: string[];
  settings?: Setting[];
  new?: string;
  link?: { href: string; label: string };
}

interface Section {
  id: string;
  title: string;
  intro: string;
  cards: Card[];
}

const sections = features.sections as Section[];
const featureCount = sections.reduce((sum, section) => sum + section.cards.length, 0);
const { resources, troopsByResource, emissaryTowns } = parseSpecialResources();

const settingClass = (value: string) =>
  value === 'On' ? 'setting-on' : value === 'Off' ? 'setting-off' : 'setting-value';
const fmt = (value?: number) => (value === undefined ? '' : String(value));
const updated = new Date(`${features.updatedAt}T12:00:00Z`).toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout
  title="Features"
  description="Every gameplay system in TAOM: the War of the Ring, careers, enlistment, special resources, creatures, battle and more."
  hideNav={true}
  hideFooter={true}
  bodyClass="taom-features-body"
  mainClass="taom-features-main"
>
  <div class="features-page">
    <div class="topbar-wrap">
      <Topbar />
    </div>

    <main class="features-shell">
      <section class="page-intro">
        <p class="eyebrow">What TAOM Adds</p>
        <h1>Features</h1>
        <p class="intro-copy">
          The systems that make TAOM's campaign, battles and world play differently from the base game. Most of them can
          be switched off or tuned in the game's Mod Options; the default for each is shown on its card.
        </p>
        <nav class="page-breadcrumb"><a href="/mod-info">Mod Info</a> / Features</nav>
        <p class="page-version">Based on TAOM {features.modVersion} · updated {updated}</p>
      </section>

      <section class="features-summary" aria-label="Features page summary">
        <article class="summary-card">
          <span class="summary-label">Feature Areas</span>
          <strong>{sections.length}</strong>
        </article>
        <article class="summary-card">
          <span class="summary-label">Features</span>
          <strong>{featureCount}</strong>
        </article>
        <article class="summary-card">
          <span class="summary-label">Careers</span>
          <strong>{features.careerCount}</strong>
        </article>
        <article class="summary-card">
          <span class="summary-label">Mod Options</span>
          <strong>{features.modOptionsCount}</strong>
        </article>
      </section>

      <section class="features-toolbar" aria-label="Find a feature">
        <nav class="section-links" aria-label="Feature areas">
          {sections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}
        </nav>
        <label class="feature-search">
          <span class="visually-hidden">Search features</span>
          <input type="search" placeholder="Search features…" autocomplete="off" data-feature-search />
        </label>
        <p class="search-empty" hidden data-search-empty>No feature matches that search.</p>
      </section>

      <div class="category-stack">
        {
          sections.map((section) => (
            <section class="section-block" id={section.id} data-feature-section>
              <div class="section-heading">
                <h2>{section.title}</h2>
                <p class="section-copy">{section.intro}</p>
              </div>

              <div class="features-grid">
                {section.cards.map((card) => (
                  <article class="feature-card" data-feature-card>
                    <div class="feature-header">
                      <h3>{card.title}</h3>
                      {card.new && <span class="status-badge">New in {card.new}</span>}
                    </div>

                    <p class="feature-desc">{card.summary}</p>

                    {card.points && card.points.length > 0 && (
                      <ul class="feature-details">
                        {card.points.map((point) => (
                          <li>{point}</li>
                        ))}
                      </ul>
                    )}

                    {card.link && (
                      <a class="feature-link" href={card.link.href}>
                        {card.link.label} →
                      </a>
                    )}

                    {card.settings && card.settings.length > 0 && (
                      <div class="setting-chips">
                        <span class="setting-label">Mod Options</span>
                        {card.settings.map((setting) => (
                          <span class:list={['setting-chip', settingClass(setting.default)]}>
                            {setting.name}: {setting.default}
                          </span>
                        ))}
                      </div>
                    )}
                  </article>
                ))}
              </div>

              {section.id === 'armies' && resources.length > 0 && (
                <div class="resource-tables" data-feature-card>
                  <h3 id="special-resources">Special resources</h3>
                  <p class="table-note">
                    What each realm earns, straight from the mod's files. "Daily" is per town held; the others are per
                    event.
                  </p>
                  <div class="data-table-wrapper resource-wrapper">
                    <table class="resource-table">
                      <thead>
                        <tr>
                          <th scope="col">Resource</th>
                          <th scope="col">Realms</th>
                          <th scope="col">Daily</th>
                          <th scope="col">Battle won</th>
                          <th scope="col">Raid</th>
                          <th scope="col">Siege won</th>
                          <th scope="col">Prisoner</th>
                          <th scope="col">Tournament</th>
                          <th scope="col">Hideout</th>
                        </tr>
                      </thead>
                      <tbody>
                        {resources.map((r) => (
                          <tr>
                            <th scope="row">{r.name}</th>
                            <td class="realms">{r.realms.join(', ')}</td>
                            <td>{r.dailyPerTown}</td>
                            <td>{r.battle}</td>
                            <td>{r.raid}</td>
                            <td>{r.siege}</td>
                            <td>{r.prisoner}</td>
                            <td>{r.tournament}</td>
                            <td>{r.hideout}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>

                  <h3 id="elite-troops">Elite troops and their price</h3>
                  <p class="table-note">
                    <strong>Buy</strong> is the price at the emissary in {emissaryTowns.map((t) => t.name).join(', ')}.
                    <strong>Upgrade</strong> is the price to upgrade into the troop on the party screen,
                    <strong>Recruit</strong> a one-time charge when it joins another way (as a volunteer or from your
                    prisoners), and <strong>Upkeep</strong> what each soldier costs per day. A blank means none.
                  </p>
                  {troopsByResource.map((group) => (
                    <details class="troop-group">
                      <summary>
                        {group.resource.name}
                        <span class="troop-count">
                          {group.resource.realms.join(', ')} · {group.troops.length} troops
                        </span>
                      </summary>
                      <div class="data-table-wrapper resource-wrapper">
                        <table class="resource-table">
                          <thead>
                            <tr>
                              <th scope="col">Troop</th>
                              <th scope="col">Realm</th>
                              <th scope="col">Buy</th>
                              <th scope="col">Upgrade</th>
                              <th scope="col">Recruit</th>
                              <th scope="col">Upkeep</th>
                            </tr>
                          </thead>
                          <tbody>
                            {group.troops.map((t) => (
                              <tr>
                                <th scope="row">{t.name}</th>
                                <td class="realms">{t.realm ?? ''}</td>
                                <td>{fmt(t.buy)}</td>
                                <td>{fmt(t.upgrade)}</td>
                                <td>{fmt(t.recruit)}</td>
                                <td>{fmt(t.upkeep)}</td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>
                    </details>
                  ))}
                </div>
              )}
            </section>
          ))
        }
      </div>

      <p class="page-sources">
        Written from TAOM's source code, its in-game settings and the team's feature posts on Discord. Something wrong
        or missing? Tell us on <a href="/community">Discord</a>.
      </p>
    </main>
  </div>
</BaseLayout>

<script>
  // Search: hides cards (and whole sections) that do not contain every word typed.
  function initFeatureSearch() {
    const input = document.querySelector<HTMLInputElement>('[data-feature-search]');
    if (!input || input.dataset.ready) return;
    input.dataset.ready = 'true';
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-feature-section]'));
    const empty = document.querySelector<HTMLElement>('[data-search-empty]');
    const cards = sections.map((section) =>
      Array.from(section.querySelectorAll<HTMLElement>('[data-feature-card]')).map((card) => ({
        card,
        text: (card.textContent || '').toLowerCase(),
      })),
    );

    input.addEventListener('input', () => {
      const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      sections.forEach((section, i) => {
        let sectionShown = 0;
        for (const { card, text } of cards[i]) {
          const match = words.every((word) => text.includes(word));
          card.hidden = !match;
          if (match) sectionShown++;
        }
        section.hidden = sectionShown === 0;
        shown += sectionShown;
      });
      if (empty) empty.hidden = shown > 0;
    });
  }

  document.addEventListener('astro:page-load', initFeatureSearch);
</script>

<style>
  :global(body.taom-features-body) {
    min-height: 100vh;
    background:
      linear-gradient(180deg, rgba(7, 5, 5, 0.74), rgba(7, 5, 5, 0.98)),
      radial-gradient(circle at 14% 12%, rgba(81, 134, 173, 0.14), transparent 24%),
      radial-gradient(circle at 84% 18%, rgba(138, 92, 58, 0.14), transparent 24%),
      linear-gradient(180deg, #15100f 0%, #0d0908 48%, #080606 100%);
    /* Gradients cover the top screen only, then the page continues in their last colour: stretched over
       the whole page they made Firefox redraw them while scrolling on large screens. */
    background-size: 100% 100vh;
    background-repeat: no-repeat;
    background-color: #080606;
    color: #ece4db;
  }

  :global(body.taom-features-body::before) {
    content: '';
    /* Scrolls with the page (a fixed full-screen layer made Firefox scrolling stutter). */
    position: absolute;
    inset: 0 0 auto;
    height: 100vh;
    background:
      linear-gradient(180deg, rgba(15, 10, 9, 0.36), rgba(8, 6, 6, 0.84)),
      url('/images/hero-bg.webp') center top / cover no-repeat;
    opacity: 0.13;
    pointer-events: none;
    z-index: -2;
  }

  :global(.taom-features-main) {
    display: block;
  }

  .features-page {
    min-height: 100vh;
    padding: 2rem 0.5rem;
    font-family: Georgia, 'Times New Roman', serif;
  }

  .topbar-wrap {
    width: 100%;
  }

  .features-shell {
    width: 100%;
    max-width: 84rem;
    margin: 0 auto;
    padding: 2.25rem 0.75rem 3.5rem;
    display: grid;
    /* minmax(0, 1fr): a wide table inside must scroll in its own box, not stretch the page. */
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .page-intro {
    display: grid;
    gap: 0.8rem;
    max-width: 56rem;
  }

  .eyebrow,
  .summary-label,
  .setting-label {
    font-family: 'Cinzel', 'Times New Roman', serif;
  }

  .eyebrow {
    color: #c19748;
    font-size: 0.86rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
  }

  .page-intro h1 {
    margin: 0;
    color: #f2ece4;
    font-family: 'Cinzel', 'Times New Roman', serif;
    font-size: clamp(3.7rem, 8vw, 6rem);
    line-height: 0.92;
    font-weight: 600;
    text-transform: uppercase;
  }

  .intro-copy {
    margin: 0;
    max-width: 49rem;
    color: rgba(238, 228, 219, 0.9);
    font-size: 1.18rem;
    line-height: 1.5;
  }

  .page-breadcrumb,
  .page-version {
    margin: 0;
    color: rgba(214, 199, 176, 0.68);
    font-size: 0.88rem;
  }

  .page-breadcrumb a,
  .page-sources a,
  .feature-link {
    color: #d7b26c;
    text-decoration: none;
  }

  .page-breadcrumb a:hover,
  .page-sources a:hover,
  .feature-link:hover {
    text-decoration: underline;
  }

  .features-summary {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.95rem;
  }

  .summary-card,
  .features-toolbar,
  .section-block {
    border: 1px solid rgba(120, 89, 38, 0.55);
    background: rgba(12, 10, 9, 0.935);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.28);
  }

  .summary-card {
    padding: 1.15rem 1.25rem;
    display: grid;
    gap: 0.45rem;
  }

  .summary-label {
    color: rgba(207, 182, 132, 0.85);
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .summary-card strong {
    color: #f6f0e6;
    font-family: 'Cinzel', 'Times New Roman', serif;
    font-size: 2.2rem;
    font-weight: 600;
    line-height: 1;
  }

  /* Jump links and search */
  .features-toolbar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 20rem);
    gap: 0.9rem 1.2rem;
    align-items: center;
    padding: 1rem 1.2rem;
  }

  .section-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .section-links a {
    padding: 0.35rem 0.7rem;
    border: 1px solid rgba(209, 154, 51, 0.3);
    color: #e2c27f;
    font-family: 'Cinzel', 'Times New Roman', serif;
    font-size: 0.82rem;
    text-decoration: none;
    transition:
      border-color 160ms ease,
      background 160ms ease;
  }

  .section-links a:hover {
    border-color: rgba(209, 154, 51, 0.7);
    background: rgba(209, 154, 51, 0.08);
  }

  .feature-search input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.6rem 0.8rem;
    border: 1px solid rgba(209, 154, 51, 0.4);
    background: rgba(0, 0, 0, 0.35);
    color: #f4ede3;
    font: inherit;
    font-size: 0.95rem;
  }

  .feature-search input:focus {
    outline: 2px solid rgba(209, 154, 51, 0.6);
    outline-offset: 1px;
  }

  .search-empty {
    grid-column: 1 / -1;
    margin: 0;
    color: rgba(224, 213, 198, 0.8);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .category-stack {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  .section-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    padding: 1.35rem;
    /* Room for the fixed top bar when a jump link scrolls here. */
    scroll-margin-top: 8rem;
  }

  .section-block[hidden],
  .feature-card[hidden],
  .resource-tables[hidden] {
    display: none;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: end;
  }

  .section-heading h2,
  .feature-card h3,
  .resource-tables h3 {
    margin: 0;
    color: #f4ede3;
    font-family: 'Cinzel', 'Times New Roman', serif;
  }

  .section-heading h2 {
    font-size: 2rem;
    line-height: 1.04;
  }

  .section-copy,
  .feature-desc,
  .feature-details li,
  .table-note,
  .page-sources {
    color: rgba(224, 213, 198, 0.8);
    line-height: 1.58;
  }

  .section-copy {
    margin: 0;
    max-width: 34rem;
    text-align: right;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .feature-card {
    padding: 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
  }

  .feature-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.7rem;
    flex-wrap: wrap;
  }

  .feature-card h3 {
    font-size: 1.16rem;
    line-height: 1.12;
  }

  .status-badge {
    font-size: 0.66rem;
    font-weight: 700;
    text-transform: uppercase;
    padding: 0.16rem 0.52rem;
    border-radius: 3px;
    letter-spacing: 0.5px;
    white-space: nowrap;
    background: rgba(209, 154, 51, 0.16);
    color: #e7bd62;
  }

  .feature-desc {
    margin: 0 0 0.8rem;
    font-size: 0.95rem;
  }

  .feature-details {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .feature-details li {
    font-size: 0.88rem;
    padding: 0.2rem 0 0.2rem 1.2rem;
    position: relative;
  }

  .feature-details li::before {
    content: '\2022';
    color: rgba(210, 169, 95, 0.9);
    position: absolute;
    left: 0.2rem;
  }

  .feature-link {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 0.9rem;
  }

  .setting-chips {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.85rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .setting-label {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin-right: 0.25rem;
  }

  .setting-chip {
    display: inline-flex;
    align-items: center;
    min-height: 1.8rem;
    padding: 0.1rem 0.45rem;
    border-radius: 3px;
    font-size: 0.74rem;
    font-weight: 600;
  }

  .setting-on {
    background: rgba(76, 175, 80, 0.15);
    color: #7cc97f;
  }

  .setting-off {
    background: rgba(255, 167, 38, 0.12);
    color: #ffb74d;
  }

  .setting-value {
    background: rgba(120, 160, 210, 0.14);
    color: #a9c7ea;
  }

  /* Special resource tables */
  .resource-tables {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    padding: 1.2rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.03);
  }

  .resource-tables h3 {
    font-size: 1.25rem;
    scroll-margin-top: 8rem;
  }

  .resource-tables h3:not(:first-child) {
    margin-top: 0.8rem;
  }

  .table-note {
    margin: 0;
    font-size: 0.9rem;
  }

  .table-note strong {
    color: #f0e3c8;
  }

  .resource-wrapper {
    border-color: rgba(255, 255, 255, 0.1);
  }

  .resource-table {
    width: 100%;
    border-collapse: collapse;
    font-family:
      system-ui,
      -apple-system,
      'Segoe UI',
      sans-serif;
    font-size: 0.86rem;
  }

  .resource-table th,
  .resource-table td {
    padding: 0.45rem 0.7rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    text-align: right;
    white-space: nowrap;
  }

  .resource-table thead th {
    position: sticky;
    top: 0;
    background: #17120e;
    color: #e2c27f;
    font-weight: 600;
  }

  .resource-table th[scope='row'],
  .resource-table thead th:first-child,
  .resource-table .realms,
  .resource-table thead th:nth-child(2) {
    text-align: left;
  }

  .resource-table th[scope='row'] {
    color: #f4ede3;
    font-weight: 600;
  }

  .resource-table td {
    color: rgba(224, 213, 198, 0.85);
    font-variant-numeric: tabular-nums;
  }

  .resource-table .realms {
    white-space: normal;
    min-width: 9rem;
  }

  .resource-table tbody tr:hover {
    background: rgba(209, 154, 51, 0.06);
  }

  .troop-group {
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .troop-group summary {
    cursor: pointer;
    padding: 0.7rem 0.9rem;
    color: #f4ede3;
    font-family: 'Cinzel', 'Times New Roman', serif;
    font-size: 1rem;
  }

  .troop-group summary:hover {
    background: rgba(209, 154, 51, 0.06);
  }

  .troop-count {
    margin-left: 0.6rem;
    color: rgba(214, 199, 176, 0.7);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.85rem;
  }

  .troop-group .resource-wrapper {
    border-width: 1px 0 0;
    border-radius: 0;
  }

  .page-sources {
    margin: 0;
    font-size: 0.9rem;
    text-align: center;
  }

  @media (max-width: 1180px) {
    .features-summary {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .features-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 980px) {
    .features-shell {
      padding-top: 1.8rem;
    }

    .section-heading {
      flex-direction: column;
      align-items: start;
    }

    .section-copy {
      max-width: none;
      text-align: left;
    }

    .features-toolbar {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .features-page {
      padding: 1rem 0.15rem;
    }

    .features-shell {
      padding-inline: 0.4rem;
    }

    .section-block {
      padding: 1rem;
      scroll-margin-top: 6.5rem;
    }
  }
</style>
