---
import LordsRows from '../components/LordsRows.astro';
import Topbar from '../components/Topbar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatMetaLabel, sortTableLords, visibleLords } from '../lib/lords-table';
import { getCultureDisplayName, parseKingdomsFromXslt } from '../lib/parse-xml';

const allLords = visibleLords();
const kingdomsData = parseKingdomsFromXslt();

function normalizeColor(value: string): string | null {
  if (!value) return null;
  const cleaned = value.trim().replace(/^0x/i, '').replace(/^#/i, '');
  if (cleaned.length === 8) return `#${cleaned.slice(2).toUpperCase()}`;
  if (cleaned.length === 6) return `#${cleaned.toUpperCase()}`;
  return null;
}

function hexToRgb(hex: string): string {
  const cleaned = hex.replace('#', '');
  const numeric = Number.parseInt(cleaned, 16);
  const red = (numeric >> 16) & 255;
  const green = (numeric >> 8) & 255;
  const blue = numeric & 255;
  return `${red}, ${green}, ${blue}`;
}

const lordNameMap = new Map<string, string>();
for (const lord of allLords) lordNameMap.set(lord.id, lord.name);

function lookupName(id: string): string {
  return lordNameMap.get(id) || formatMetaLabel(id);
}

// Same order as /lords-bios.json (src/lib/lords-table.ts), which the page script matches rows against.
sortTableLords(allLords);

const cultures = [...new Set(allLords.map((l) => l.culture).filter(Boolean))].sort();
const kingdomOptions = [...new Set(allLords.map((l) => l.kingdom).filter(Boolean))].sort((a, b) =>
  formatMetaLabel(a).localeCompare(formatMetaLabel(b)),
);

const fallbackCultureColors: Record<string, string> = {
  mercenary: '#8F7A60',
  lothlorien: '#D8C371',
  troll: '#6E6A48',
};

const cultureColorMap = new Map<string, { hex: string; rgb: string }>();
for (const kingdom of kingdomsData) {
  const hex = normalizeColor(kingdom.color);
  if (hex && kingdom.culture) {
    cultureColorMap.set(kingdom.culture, { hex, rgb: hexToRgb(hex) });
  }
}

for (const [culture, hex] of Object.entries(fallbackCultureColors)) {
  if (!cultureColorMap.has(culture)) {
    cultureColorMap.set(culture, { hex, rgb: hexToRgb(hex) });
  }
}

// Row colours: one rule per culture instead of an inline style on every row.
const cultureCss = [
  '.lord-section tbody tr{--culture-accent:#7A664A;--culture-rgb:122, 102, 74}',
  ...cultures.map((culture) => {
    const tone = cultureColorMap.get(culture);
    return tone
      ? `.lord-section tr[data-culture="${culture}"]{--culture-accent:${tone.hex};--culture-rgb:${tone.rgb}}`
      : '';
  }),
].join('');

const cultureCounts = new Map<string, number>();
for (const lord of allLords) {
  cultureCounts.set(lord.culture, (cultureCounts.get(lord.culture) || 0) + 1);
}

const cultureTabs = [
  { culture: 'all', label: 'All', count: allLords.length },
  ...cultures
    .map((culture) => ({
      culture,
      label: getCultureDisplayName(culture) || culture,
      count: cultureCounts.get(culture) || 0,
    }))
    .sort((a, b) => a.label.localeCompare(b.label)),
];

const aliveSingles = allLords.filter((lord) => lord.alive && !lord.spouse && (lord.age || 0) >= 18).length;
const clanCount = new Set(allLords.map((lord) => lord.clan).filter(Boolean)).size;

const COMBAT_SKILLS = ['OneHanded', 'TwoHanded', 'Polearm', 'Bow', 'Crossbow', 'Throwing', 'Riding', 'Athletics'];
const NONCOMBAT_SKILLS = [
  'Crafting',
  'Scouting',
  'Tactics',
  'Roguery',
  'Charm',
  'Leadership',
  'Trade',
  'Steward',
  'Medicine',
  'Engineering',
];

function sumSkills(skills: Record<string, number>, keys: string[]): number {
  return keys.reduce((total, key) => total + (skills[key] || 0), 0);
}

// Colour band of the Total cell (classes tier-1 to tier-5 in the global style block below).
function totalTier(total: number): number {
  if (total <= 1500) return 1;
  if (total <= 2200) return 2;
  if (total <= 2900) return 3;
  if (total <= 3600) return 4;
  return 5;
}

const SKILL_COLUMNS = [...COMBAT_SKILLS, ...NONCOMBAT_SKILLS];
const TRAIT_COLUMNS = ['Honor', 'Generosity', 'Mercy', 'Valor', 'Calculating'];

const lordRows = allLords.map((lord) => {
  const combat = sumSkills(lord.skills, COMBAT_SKILLS);
  const nonCombat = sumSkills(lord.skills, NONCOMBAT_SKILLS);
  return {
    id: lord.id,
    name: lord.name,
    alive: lord.alive,
    culture: lord.culture,
    kingdom: lord.kingdom || '',
    kingdomDisplay: lord.kingdom ? formatMetaLabel(lord.kingdom) : '',
    isFemale: lord.isFemale,
    age: lord.age || 0,
    group: lord.defaultGroup || '',
    skills: SKILL_COLUMNS.map((skill) => lord.skills[skill] || 0),
    combat,
    nonCombat,
    total: combat + nonCombat,
    totalTier: totalTier(combat + nonCombat),
    traits: TRAIT_COLUMNS.map((trait) => lord.traits[trait]),
    clan: lord.clan ? formatMetaLabel(lord.clan) : '',
    spouse: lord.spouse ? lookupName(lord.spouse) : '',
    father: lord.father ? lookupName(lord.father) : '',
    mother: lord.mother ? lookupName(lord.mother) : '',
    children: lord.children.map((child) => lookupName(child)).join(', '),
    biography: lord.biography || '',
  };
});

const headerCols = [
  { col: 'name', label: 'Name', cls: '' },
  { col: 'kingdom', label: 'Kingdom', cls: '' },
  { col: 'gender', label: 'Gender', cls: '' },
  { col: 'age', label: 'Age', cls: 'col-num' },
  { col: 'defaultGroup', label: 'Group', cls: 'section-start' },
  { col: 'oneHanded', label: '1H', cls: 'col-num section-start' },
  { col: 'twoHanded', label: '2H', cls: 'col-num' },
  { col: 'polearm', label: 'Pol', cls: 'col-num' },
  { col: 'bow', label: 'Bow', cls: 'col-num' },
  { col: 'crossbow', label: 'Xbw', cls: 'col-num' },
  { col: 'throwing', label: 'Thr', cls: 'col-num' },
  { col: 'riding', label: 'Rid', cls: 'col-num' },
  { col: 'athletics', label: 'Ath', cls: 'col-num' },
  { col: 'crafting', label: 'Cra', cls: 'col-num' },
  { col: 'scouting', label: 'Sco', cls: 'col-num' },
  { col: 'tactics', label: 'Tac', cls: 'col-num' },
  { col: 'roguery', label: 'Rog', cls: 'col-num' },
  { col: 'charm', label: 'Chr', cls: 'col-num' },
  { col: 'leadership', label: 'Led', cls: 'col-num' },
  { col: 'trade', label: 'Trd', cls: 'col-num' },
  { col: 'steward', label: 'Stw', cls: 'col-num' },
  { col: 'medicine', label: 'Med', cls: 'col-num' },
  { col: 'engineering', label: 'Eng', cls: 'col-num' },
  { col: 'combat', label: 'Cbt', cls: 'col-num section-start' },
  { col: 'nonCombat', label: 'NonC', cls: 'col-num' },
  { col: 'total', label: 'Total', cls: 'col-num' },
  { col: 'honor', label: 'Hon', cls: 'col-num section-start' },
  { col: 'generosity', label: 'Gen', cls: 'col-num' },
  { col: 'mercy', label: 'Merc', cls: 'col-num' },
  { col: 'valor', label: 'Val', cls: 'col-num' },
  { col: 'calculating', label: 'Calc', cls: 'col-num' },
  { col: 'clan', label: 'Clan', cls: 'section-start' },
  { col: 'spouse', label: 'Spouse', cls: '' },
  { col: 'father', label: 'Father', cls: '' },
  { col: 'mother', label: 'Mother', cls: '' },
  { col: 'children', label: 'Children', cls: '' },
];
---

<BaseLayout
  title="Lords"
  description="Complete lord database for TAOM - family ties, skills, traits, and noble houses"
  hideNav={true}
  hideFooter={true}
  bodyClass="taom-lords-body"
  mainClass="taom-lords-main"
>
  <div class="lords-page">
    <Topbar />

    <main class="lords-shell">
      <div class="lords-overview">
        <section class="page-intro">
          <p class="eyebrow">Archives of Middle-earth</p>
          <h1>Lords</h1>
          <p class="intro-copy">
            Survey the noble houses of TAOM through one searchable roster. Filter by realm, court, and marriage status,
            then open any lord to read their biography and compare skills, lineage, and traits.
          </p>
          <nav class="page-breadcrumb"><a href="/database/">Database</a> / Lords</nav>
        </section>

        <section class="lords-summary" aria-label="Lord database summary">
          <article class="summary-card">
            <span class="summary-label">Total Lords</span>
            <strong>{allLords.length}</strong>
          </article>
          <article class="summary-card">
            <span class="summary-label">Realms Covered</span>
            <strong>{cultures.length}</strong>
          </article>
          <article class="summary-card">
            <span class="summary-label">Noble Houses</span>
            <strong>{clanCount}</strong>
          </article>
          <article class="summary-card">
            <span class="summary-label">Alive & Unwed</span>
            <strong>{aliveSingles}</strong>
          </article>
        </section>

        <section class="utility-panel">
          <div class="balance-callout">
            <p class="balance-kicker">House Records</p>
            <h2>Trace Each Lord Back to Their Clan</h2>
            <p>
              Need the broader noble context behind a ruler, heir, or marriage candidate? The clan archive helps map the
              families, houses, and kinship webs behind the roster.
            </p>
            <a href="/clans/">Open Clan Archive</a>
          </div>

          <div class="controls-card">
            <div class="controls-heading">
              <p class="controls-kicker">Filter the Roster</p>
              <span class="result-count" id="result-count">{allLords.length} lords</span>
            </div>

            <div class="table-controls">
              <label class="control-field control-search">
                <span>Search</span>
                <input type="text" id="search" placeholder="Search by name, ID, or biography..." />
              </label>

              <label class="control-field">
                <span>Kingdom</span>
                <select id="filter-kingdom">
                  <option value="">All Kingdoms</option>
                  {kingdomOptions.map((kingdom) => <option value={kingdom}>{formatMetaLabel(kingdom)}</option>)}
                </select>
              </label>

              <label class="control-field">
                <span>Gender</span>
                <select id="filter-gender">
                  <option value="">All Genders</option>
                  <option value="male">Male</option>
                  <option value="female">Female</option>
                </select>
              </label>

              <label class="control-field">
                <span>Marriage</span>
                <select id="filter-married">
                  <option value="">All</option>
                  <option value="single">Single</option>
                  <option value="married">Married</option>
                </select>
              </label>
            </div>
          </div>
        </section>
      </div>

      <section class="sections-stack">
        <div class="realm-browser">
          <div class="realm-header">
            <div class="realm-tabs-shell">
              <div class="realm-tabs" role="tablist" aria-label="Select a lord realm">
                {
                  cultureTabs.map((tab) => (
                    <button
                      type="button"
                      class:list={['realm-tab', { 'is-selected': tab.culture === 'all' }]}
                      data-culture={tab.culture}
                      role="tab"
                      aria-selected={tab.culture === 'all' ? 'true' : 'false'}
                    >
                      <span>{tab.label}</span>
                      <small>({tab.count})</small>
                    </button>
                  ))
                }
              </div>
            </div>
          </div>

          <div class="roster-panel">
            <div class="roster-panel-head">
              <div>
                <p class="roster-panel-title">Lords Roster</p>
                <p class="roster-panel-subtitle">Click any row to open that lord&apos;s biography.</p>
              </div>
              <span class="section-count" id="table-count">({allLords.length})</span>
            </div>

            <style is:inline set:html={cultureCss}></style>
            <div class="data-table-wrapper" tabindex="0" role="region" aria-label="Lords table">
              <table class="data-table lord-section">
                <thead>
                  <tr>
                    {
                      headerCols.map((header) => (
                        <th data-col={header.col} class={header.cls}>
                          {header.label}
                        </th>
                      ))
                    }
                  </tr>
                </thead>
                <tbody id="lords-table-body">
                  <LordsRows lords={lordRows} />
                </tbody>
              </table>
            </div>

            <p class="empty-state" id="empty-state" hidden>No lords match the current realm and filter selection.</p>
          </div>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  import { initPager, initSorting } from '../scripts/data-table';

  document.addEventListener('astro:page-load', () => {
    const searchInput = document.getElementById('search') as HTMLInputElement;
    const kingdomFilter = document.getElementById('filter-kingdom') as HTMLSelectElement;
    const genderFilter = document.getElementById('filter-gender') as HTMLSelectElement;
    const marriedFilter = document.getElementById('filter-married') as HTMLSelectElement;
    const resultCount = document.getElementById('result-count') as HTMLElement;
    const tableCount = document.getElementById('table-count') as HTMLElement;
    const emptyState = document.getElementById('empty-state') as HTMLElement;
    const tabButtons = Array.from(document.querySelectorAll('.realm-tab')) as HTMLButtonElement[];
    const tableBody = document.getElementById('lords-table-body') as HTMLTableSectionElement;
    const rows = Array.from(tableBody.querySelectorAll('tr')) as HTMLTableRowElement[];
    if (
      !searchInput ||
      !kingdomFilter ||
      !genderFilter ||
      !marriedFilter ||
      !resultCount ||
      !tableCount ||
      !emptyState
    ) {
      return;
    }

    const params = new URLSearchParams(window.location.search);
    searchInput.value = params.get('search') || '';
    kingdomFilter.value = params.get('kingdom') || '';
    genderFilter.value = params.get('gender') || '';
    marriedFilter.value = params.get('married') || '';

    let activeCulture = params.get('culture') || 'all';
    if (!tabButtons.some((button) => button.dataset.culture === activeCulture)) {
      activeCulture = 'all';
    }

    function clearBiographyRows() {
      document.querySelectorAll('.bio-row').forEach((row) => row.remove());
    }

    function updateUrl() {
      const nextParams = new URLSearchParams();
      if (searchInput.value) nextParams.set('search', searchInput.value);
      if (kingdomFilter.value) nextParams.set('kingdom', kingdomFilter.value);
      if (genderFilter.value) nextParams.set('gender', genderFilter.value);
      if (marriedFilter.value) nextParams.set('married', marriedFilter.value);
      if (activeCulture !== 'all') nextParams.set('culture', activeCulture);
      const query = nextParams.toString();
      const url = query ? `${window.location.pathname}?${query}` : window.location.pathname;
      window.history.replaceState({}, '', url);
    }

    // Rows carry few attributes (smaller page); read the rest from the cells once.
    // Columns: 0 name, 1 kingdom, 2 gender, ... 32 spouse.
    const rowInfo = rows.map((row) => ({
      row,
      name: (row.querySelector('.lord-name')?.textContent || '').toLowerCase(),
      id: (row.dataset.id || '').toLowerCase(),
      bio: '',
      biography: '',
      culture: row.dataset.culture || '',
      kingdom: row.dataset.kingdom || '',
      gender: (row.cells[2]?.textContent || '').trim().toLowerCase(),
      married: row.cells[32]?.textContent?.trim() ? 'married' : 'single',
    }));

    // Biographies are not in the page (they were half of its download); they come from /lords-bios.json, in the
    // table's row order with each row's id for a check. Loaded when the browser is idle, or at once on the first search
    // or row click. Until then, search matches names and ids, and runs again when the biographies arrive.
    const w = window as Window & { __taomLordBios?: Promise<{ ids: string[]; bios: string[] } | null> };
    let biosApplied = false;
    function loadBiographies() {
      w.__taomLordBios ??= fetch('/lords-bios.json')
        .then((response) => (response.ok ? response.json() : null))
        .catch(() => null);
      return w.__taomLordBios.then((data) => {
        if (!data || biosApplied) return;
        biosApplied = true;
        const sameOrder =
          data.ids.length === rowInfo.length && rowInfo.every((info, i) => data.ids[i].toLowerCase() === info.id);
        // Fallback if the rows ever stop lining up: match by id (first biography for that id).
        const byId = new Map<string, string>();
        if (!sameOrder)
          data.ids.forEach((id, i) => !byId.has(id.toLowerCase()) && byId.set(id.toLowerCase(), data.bios[i]));
        rowInfo.forEach((info, i) => {
          info.biography = (sameOrder ? data.bios[i] : byId.get(info.id)) || '';
          info.bio = info.biography.toLowerCase();
        });
        if (searchInput.value) filterRows();
      });
    }
    const infoByRow = new Map(rowInfo.map((info) => [info.row, info]));
    if ('requestIdleCallback' in window) window.requestIdleCallback(() => loadBiographies(), { timeout: 2000 });
    else setTimeout(loadBiographies, 1200);
    searchInput.addEventListener('focus', () => loadBiographies(), { once: true });

    function attachBioHandlers() {
      // One listener for the whole table instead of one per row.
      if (tableBody.dataset.bioBound === 'true') return;
      tableBody.dataset.bioBound = 'true';
      tableBody.addEventListener('click', async (event) => {
        const row = (event.target as Element | null)?.closest('tr');
        if (!row || row.classList.contains('bio-row') || !tableBody.contains(row)) return;
        await loadBiographies();
        const bio = infoByRow.get(row as HTMLTableRowElement)?.biography;
        const existing = row.nextElementSibling;
        if (existing?.classList.contains('bio-row')) {
          existing.remove();
          return;
        }

        clearBiographyRows();

        if (bio) {
          const bioRow = document.createElement('tr');
          bioRow.className = 'bio-row';
          const td = document.createElement('td');
          td.colSpan = row.cells.length;
          td.className = 'bio-cell';
          td.textContent = bio;
          bioRow.appendChild(td);
          row.after(bioRow);
        }
      });
    }

    const pager = initPager('table.lord-section');

    function filterRows() {
      clearBiographyRows();

      const search = searchInput.value.toLowerCase();
      const kingdom = kingdomFilter.value;
      const gender = genderFilter.value;
      const married = marriedFilter.value;
      let visibleCount = 0;

      for (const info of rowInfo) {
        const show =
          (activeCulture === 'all' || info.culture === activeCulture) &&
          (!search || info.name.includes(search) || info.id.includes(search) || info.bio.includes(search)) &&
          (!kingdom || info.kingdom === kingdom) &&
          (!gender || info.gender === gender) &&
          (!married || info.married === married);
        info.row.style.display = show ? '' : 'none';
        if (show) visibleCount += 1;
      }

      tabButtons.forEach((button) => {
        const selected = button.dataset.culture === activeCulture;
        button.classList.toggle('is-selected', selected);
        button.setAttribute('aria-selected', selected ? 'true' : 'false');
      });

      resultCount.textContent = `${visibleCount} lords`;
      tableCount.textContent = `(${visibleCount})`;
      emptyState.hidden = visibleCount !== 0;
      pager.refresh();
      updateUrl();
    }

    tabButtons.forEach((button) => {
      button.addEventListener('click', () => {
        activeCulture = button.dataset.culture || 'all';
        filterRows();
      });
    });

    searchInput.addEventListener('input', filterRows);
    kingdomFilter.addEventListener('change', filterRows);
    genderFilter.addEventListener('change', filterRows);
    marriedFilter.addEventListener('change', filterRows);

    attachBioHandlers();
    initSorting('table.lord-section');
    document.querySelectorAll('table.lord-section th[data-col]').forEach((header) => {
      header.addEventListener('click', clearBiographyRows);
    });

    filterRows();
  });
</script>

<style>
  :global(body.taom-lords-body) {
    min-height: 100vh;
    background:
      linear-gradient(180deg, rgba(7, 5, 5, 0.66), rgba(7, 5, 5, 0.97)),
      radial-gradient(circle at 16% 14%, rgba(132, 76, 38, 0.16), transparent 24%),
      radial-gradient(circle at 84% 18%, rgba(94, 48, 31, 0.14), transparent 22%),
      linear-gradient(180deg, #17100e 0%, #0d0908 48%, #080606 100%);
    /* Gradients cover the top screen only, then the page continues in their last colour: stretched over
       the whole page they made Firefox redraw them while scrolling on large screens. */
    background-size: 100% 100vh;
    background-repeat: no-repeat;
    background-color: #080606;
    color: #ece4db;
  }

  :global(body.taom-lords-body::before) {
    content: '';
    /* Scrolls with the page (a fixed full-screen layer made Firefox scrolling stutter). */
    position: absolute;
    inset: 0 0 auto;
    height: 100vh;
    background:
      linear-gradient(180deg, rgba(15, 10, 9, 0.28), rgba(8, 6, 6, 0.82)),
      url('/images/hero-bg.webp') center top / cover no-repeat;
    opacity: 0.16;
    pointer-events: none;
    z-index: -2;
  }

  :global(.taom-lords-main) {
    display: block;
  }

  .lords-page {
    min-height: 100vh;
    padding: 2rem 0.5rem;
    font-family: Georgia, 'Times New Roman', serif;
  }

  .lords-shell {
    width: 100%;
    max-width: none;
    margin: 0 auto;
    padding: 2.25rem 0 3.375rem;
  }

  .lords-overview {
    max-width: 82.5rem;
    margin: 0 auto;
    padding: 0 1rem;
    display: grid;
    gap: 1.75rem;
  }

  .page-intro {
    display: grid;
    gap: 0.8rem;
    max-width: 52rem;
  }

  .eyebrow,
  .controls-kicker,
  .balance-kicker,
  .summary-label,
  .roster-panel-title,
  .roster-panel-subtitle,
  .realm-tab,
  .result-count {
    font-family: 'Cinzel', 'Times New Roman', serif;
  }

  .eyebrow,
  .controls-kicker,
  .balance-kicker {
    color: #b88635;
    font-size: 0.88rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
  }

  .page-intro h1 {
    margin: 0;
    color: #f2ece4;
    font-family: 'Cinzel', 'Times New Roman', serif;
    font-size: clamp(3.8rem, 8vw, 6.1rem);
    line-height: 0.92;
    font-weight: 600;
    text-transform: uppercase;
  }

  .page-breadcrumb {
    color: rgba(214, 199, 176, 0.68);
    font-size: 0.88rem;
  }

  .page-breadcrumb a {
    color: #d7b26c;
    text-decoration: none;
  }

  .page-breadcrumb a:hover {
    text-decoration: underline;
  }

  .intro-copy {
    margin: 0;
    max-width: 46rem;
    color: rgba(238, 228, 219, 0.92);
    font-size: 1.25rem;
    line-height: 1.44;
  }

  .lords-summary {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.95rem;
  }

  .summary-card,
  .controls-card,
  .roster-panel,
  .realm-header {
    border: 1px solid rgba(120, 89, 38, 0.55);
    background: rgba(12, 10, 9, 0.935);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.28);
  }

  .summary-card {
    padding: 1.15rem 1.25rem;
    display: grid;
    gap: 0.45rem;
  }

  .summary-label {
    color: rgba(207, 182, 132, 0.85);
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .summary-card strong {
    color: #f6f0e6;
    font-family: 'Cinzel', 'Times New Roman', serif;
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1;
  }

  .utility-panel {
    display: grid;
