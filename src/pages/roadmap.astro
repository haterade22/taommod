---
import Topbar from '../components/Topbar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const contributorCount = 4;

const roadmapDisciplines = [
  {
    discipline: '3D Art',
    lead: 'KEYforce',
    completed: [
      'Dale Armors',
      'Dale Weapons',
      'Dale Shields',
      'Mordor Orcs Armor',
      'Mordor Orcs Weapons',
      'Black Númenóreans',
      'Gondor Revamp 3/4',
    ],
    wip: ['Gondor Revamp 4/4'],
    next: ['Harad Armors', 'Lothlorien Armors', 'Khand', 'Umbar', 'Mirkwood Armors', 'Map Icons Revamp'],
  },
  {
    discipline: '2D Art',
    lead: 'Thyrell, AI',
    completed: [],
    wip: ['Banners', 'Career UI', 'Game UI'],
    next: [],
  },
  {
    discipline: 'Map Design',
    lead: 'Lemmy',
    completed: [],
    wip: ['Polish'],
    next: [],
  },
  {
    discipline: 'Scene Design',
    lead: 'Kysaro',
    completed: [
      'Mordor Battle Maps',
      'Rohan Battle Maps',
      'Minas Tirith',
      'West Osgiliath',
      'East Osgiliath',
      'Minas Morgul',
    ],
    wip: ['Mordor Tavern/Arenas', 'Moria', 'Edoras'],
    next: [],
  },
  {
    discipline: 'Animations',
    lead: 'Haterade',
    completed: [],
    wip: ['Spider', 'Troll', 'Elephant'],
    next: ['Mumakil'],
  },
  {
    discipline: 'Coding',
    lead: 'Haterade, Yotthani',
    completed: [],
    wip: ['Polishing', 'Stability'],
    next: [],
  },
];

const totalWip = roadmapDisciplines.reduce((sum, group) => sum + group.wip.length, 0);
const totalNext = roadmapDisciplines.reduce((sum, group) => sum + group.next.length, 0);
const disciplineOrder: string[] = ['3D Art', '2D Art', 'Map Design', 'Coding', 'Scene Design', 'Animations'];
const disciplineFocus: Record<string, string> = {
  '3D Art': 'Armour, weapons & shields',
  '2D Art': 'Banners & interface',
  'Map Design': 'Campaign map',
  Coding: 'Systems & stability',
  'Scene Design': 'Battle maps & settlements',
  Animations: 'Creatures & monsters',
};
const disciplineThemes: Record<string, { accent: string; glow: string; tint: string }> = {
  '3D Art': {
    accent: '#cf9b52',
    glow: 'rgba(207, 155, 82, 0.24)',
    tint: 'rgba(207, 155, 82, 0.08)',
  },
  '2D Art': {
    accent: '#d07f49',
    glow: 'rgba(208, 127, 73, 0.22)',
    tint: 'rgba(208, 127, 73, 0.08)',
  },
  'Map Design': {
    accent: '#6f9b7d',
    glow: 'rgba(111, 155, 125, 0.22)',
    tint: 'rgba(111, 155, 125, 0.08)',
  },
  'Scene Design': {
    accent: '#9f6e56',
    glow: 'rgba(159, 110, 86, 0.22)',
    tint: 'rgba(159, 110, 86, 0.08)',
  },
  Animations: {
    accent: '#8a6fc0',
    glow: 'rgba(138, 111, 192, 0.22)',
    tint: 'rgba(138, 111, 192, 0.08)',
  },
  Coding: {
    accent: '#7b879f',
    glow: 'rgba(123, 135, 159, 0.22)',
    tint: 'rgba(123, 135, 159, 0.08)',
  },
};

// A roadmap entry is a name, or { name, eta } once the team has a target date (e.g. 'Q1 2027'); eta shows on the timeline.
type RoadmapItem = string | { name: string; eta?: string };
const toItem = (item: RoadmapItem) => (typeof item === 'string' ? { name: item, eta: undefined } : item);

const timelineLanes = [...roadmapDisciplines]
  .sort((left, right) => disciplineOrder.indexOf(left.discipline) - disciplineOrder.indexOf(right.discipline))
  .map((group) => ({
    discipline: group.discipline,
    lead: group.lead,
    focus: disciplineFocus[group.discipline] ?? '',
    theme: disciplineThemes[group.discipline] ?? disciplineThemes['3D Art'],
    stages: [
      {
        key: 'done',
        title: 'Done',
        items: (group.completed as RoadmapItem[]).map(toItem),
        empty: 'Nothing finished yet.',
      },
      {
        key: 'now',
        title: 'In progress',
        items: (group.wip as RoadmapItem[]).map(toItem),
        empty: 'Nothing in progress.',
      },
      { key: 'next', title: 'Up next', items: (group.next as RoadmapItem[]).map(toItem), empty: 'Nothing queued yet.' },
    ],
  }));
---

<BaseLayout
  title="Roadmap"
  description="Current TAOM art and map production roadmap by discipline"
  hideNav={true}
  hideFooter={true}
  bodyClass="taom-roadmap-body"
  mainClass="taom-roadmap-main"
>
  <div class="roadmap-page">
    <Topbar />

    <main class="page-shell">
      <section class="hero-panel">
        <div class="hero-copy">
          <p class="eyebrow">Production Outlook</p>
          <h1>Roadmap</h1>
          <p class="intro-copy">
            TAOM is a very small team of developers. We have 4 active developers who use their free time to develop the
            game. Each with a specialized role in the process of building a mod. Coding, 3D, 2D, Scening, etc.
          </p>
          <p class="intro-copy">
            People do come and go throughout the development lifecycle. Please keep that in mind when reviewing the
            roadmap. We are not a triple A studio. We don't have millions of dollars for a budget. Usually it is one
            person going through days/weeks/months of pain to implement things.
          </p>
          <p class="intro-copy">All of this is subject to change due to various reasons.</p>
        </div>

        <div class="hero-stats">
          <article class="stat-card">
            <span class="stat-value">{contributorCount}</span>
            <span class="stat-label">Contributors</span>
          </article>
          <article class="stat-card">
            <span class="stat-value">{totalWip}</span>
            <span class="stat-label">Items In Progress</span>
          </article>
          <article class="stat-card">
            <span class="stat-value">{totalNext}</span>
            <span class="stat-label">Queued Next</span>
          </article>
        </div>
      </section>

      <section class="timeline" aria-label="Roadmap timeline by discipline">
        {
          timelineLanes.map((lane) => (
            <article class="lane" style={`--lane-accent: ${lane.theme.accent}; --lane-glow: ${lane.theme.glow};`}>
              <header class="lane-head">
                <h2>{lane.discipline}</h2>
                <p class="lane-focus">{lane.focus}</p>
                <p class="lane-lead">{lane.lead}</p>
              </header>

              <ol class="lane-track">
                {lane.stages.map((stage) => (
                  <li class:list={['stage', `stage-${stage.key}`]}>
                    <p class="stage-title">
                      <span class="stage-dot" aria-hidden="true" />
                      {stage.title}
                      <span class="stage-count">{stage.items.length}</span>
                    </p>
                    {stage.items.length > 0 ? (
                      <ul class="stage-items">
                        {stage.items.map((item) => (
                          <li>
                            <span class="item-name">{item.name}</span>
                            {item.eta && <span class="item-eta">{item.eta}</span>}
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="stage-empty">{stage.empty}</p>
                    )}
                  </li>
                ))}
              </ol>
            </article>
          ))
        }
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  :global(body.taom-roadmap-body) {
    min-height: 100vh;
    background:
      linear-gradient(180deg, rgba(8, 7, 8, 0.72), rgba(8, 7, 8, 0.96)),
      radial-gradient(circle at top left, rgba(181, 123, 54, 0.16), transparent 28%),
      radial-gradient(circle at 85% 12%, rgba(98, 119, 84, 0.14), transparent 24%),
      linear-gradient(180deg, #191210 0%, #0f0b0a 48%, #080707 100%);
    color: #f1e8dc;
  }

  :global(body.taom-roadmap-body::before) {
    content: '';
    position: fixed;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(15, 11, 10, 0.08), rgba(8, 7, 7, 0.56)),
      repeating-linear-gradient(
        90deg,
        transparent 0,
        transparent 87px,
        rgba(255, 255, 255, 0.02) 88px,
        transparent 89px
      );
    pointer-events: none;
    z-index: -2;
  }

  :global(.taom-roadmap-main) {
    display: block;
  }

  .roadmap-page {
    min-height: 100vh;
    padding: 2rem;
    font-family: Georgia, 'Times New Roman', serif;
  }

  .page-shell {
    width: min(100%, 84rem);
    margin: 0 auto;
    padding: 4rem 0 5rem;
    display: grid;
    gap: 1.5rem;
  }

  .hero-panel,
  .stat-card,
  .discipline-card {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(171, 129, 73, 0.3);
    border-radius: 1.2rem;
    background:
      linear-gradient(180deg, rgba(20, 15, 14, 0.94), rgba(12, 10, 10, 0.97)),
      linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent);
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.32);
  }

  .hero-panel::before,
  .stat-card::before,
  .discipline-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      140deg,
      rgba(255, 255, 255, 0.02),
      transparent 30%,
      transparent 72%,
      var(--discipline-tint, rgba(214, 176, 106, 0.05))
    );
    pointer-events: none;
  }

  .hero-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.9fr);
    gap: 1.25rem;
    border-radius: 0;
    padding: clamp(2.1rem, 4vw, 2.9rem);
    background:
      linear-gradient(180deg, rgba(12, 9, 8, 0.32), rgba(8, 7, 7, 0.62)),
      url('/images/roadmap/block-background.png') center / cover no-repeat;
  }

  .hero-panel::before {
    background: url('/images/roadmap/block-overlay.png') center / 100% 100% no-repeat;
  }

  .hero-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: url('/images/roadmap/block-border.png') center / 100% 100% no-repeat;
    pointer-events: none;
  }

  .hero-copy,
  .hero-stats,
  .discipline-card {
    position: relative;
    z-index: 3;
  }

  .eyebrow,
  .group-kicker,
  .stat-label,
  .status-stream-heading h3,
  .status-count {
    font-family: 'Cinzel', 'Times New Roman', serif;
  }

  .eyebrow,
  .group-kicker {
    margin: 0 0 0.85rem;
    font-size: 0.74rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(220, 184, 117, 0.84);
  }

  .hero-panel h1,
  .discipline-card h2 {
    margin: 0;
    color: #f8f1e8;
    font-family: 'Cinzel', 'Times New Roman', serif;
  }

  .hero-panel h1 {
    font-size: clamp(2.7rem, 4vw, 4.5rem);
    line-height: 0.92;
  }

  .intro-copy {
    max-width: 46rem;
    margin: 1rem 0 0;
    color: rgba(235, 225, 214, 0.8);
    font-size: 1.02rem;
    line-height: 1.75;
  }

  .hero-stats {
    display: grid;
    gap: 0.9rem;
    align-content: start;
  }

  .stat-card {
    display: grid;
    gap: 0.35rem;
    padding: 1.2rem 1.3rem;
  }

  .stat-value {
    color: #fbf6ef;
    font-family: 'Cinzel', 'Times New Roman', serif;
    font-size: clamp(1.9rem, 4vw, 2.9rem);
    line-height: 1;
  }

  .stat-label {
    color: rgba(220, 184, 117, 0.74);
    font-size: 0.76rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .discipline-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19.5rem, 1fr));
    gap: 1rem;
    align-items: start;
  }

  .discipline-card {
    display: grid;
    position: relative;
  }

  .discipline-card::after {
    content: '';
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 0.2rem;
    background: linear-gradient(90deg, var(--discipline-accent), transparent 72%);
    opacity: 0.9;
  }

  .discipline-card-shell {
    display: grid;
    gap: 1rem;
    height: 100%;
    padding: 1.35rem;
  }

  .discipline-card-top {
    min-width: 0;
  }

  .discipline-card h2 {
    font-size: clamp(1.5rem, 2vw, 2rem);
    line-height: 1;
  }

  .group-kicker {
    margin-bottom: 0.35rem;
    color: var(--discipline-accent);
  }

  .discipline-lead {
    margin: 0.45rem 0 0;
    color: rgba(238, 229, 219, 0.82);
    font-size: 0.92rem;
    letter-spacing: 0.04em;
  }

  .discipline-summary {
    margin: -0.2rem 0 0;
    color: rgba(223, 213, 200, 0.68);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .discipline-summary span {
    margin: 0 0.3rem;
    color: var(--discipline-accent);
  }

  .status-streams {
    display: grid;
    gap: 0.85rem;
  }

  .status-stream {
    display: grid;
    gap: 0.8rem;
    padding: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 0.95rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent), rgba(255, 255, 255, 0.02);
  }

  .status-stream-heading {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .status-stream-heading h3 {
    margin: 0;
    color: #f5eee4;
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .status-dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    flex: 0 0 auto;
  }

  .status-dot-wip {
    background: var(--discipline-accent);
    box-shadow: 0 0 0 0.3rem var(--discipline-glow);
  }

  .status-dot-next {
    background: #93a874;
    box-shadow: 0 0 0 0.3rem rgba(147, 168, 116, 0.14);
  }

  .status-dot-completed {
    background: #6fae8f;
    box-shadow: 0 0 0 0.3rem rgba(111, 174, 143, 0.16);
  }

  .status-count {
    margin-left: auto;
    color: rgba(240, 230, 218, 0.6);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .task-chip-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .task-chip-list li {
    max-width: 100%;
    padding: 0.55rem 0.78rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 999px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.015));
    color: rgba(238, 229, 219, 0.86);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .empty-state {
    margin: 0;
    color: rgba(210, 194, 176, 0.6);
    font-style: italic;
    line-height: 1.55;
  }

  @media (max-width: 1080px) {
    .hero-panel {
      grid-template-columns: 1fr;
    }
  }

  @media (min-width: 1180px) {
    .discipline-grid {
      grid-template-columns: minmax(18.5rem, 1.15fr) repeat(3, minmax(17rem, 1fr));
      grid-template-areas:
        'art3d art2d map scene'
        'art3d animation coding scene';
    }

    .discipline-card-3d {
      grid-area: art3d;
    }

    .discipline-card-2d {
      grid-area: art2d;
    }

    .discipline-card-map {
      grid-area: map;
    }

    .discipline-card-scene {
      grid-area: scene;
    }

    .discipline-card-animations {
      grid-area: animation;
    }

    .discipline-card-coding {
      grid-area: coding;
    }
  }

  @media (min-width: 1500px) {
    .discipline-grid {
      grid-template-columns: minmax(19rem, 1.2fr) repeat(3, minmax(17.5rem, 1fr));
      grid-template-areas:
        'art3d art2d map scene'
        'art3d animation coding scene';
    }

    .discipline-card-3d {
      grid-area: art3d;
    }

    .discipline-card-2d {
      grid-area: art2d;
    }

    .discipline-card-map {
      grid-area: map;
    }

    .discipline-card-scene {
      grid-area: scene;
    }

    .discipline-card-animations {
      grid-area: animation;
    }

    .discipline-card-coding {
      grid-area: coding;
    }
  }

  @media (max-width: 760px) {
    .roadmap-page {
      padding: 1rem;
    }

    .page-shell {
      padding: 2.5rem 0 3.5rem;
    }

    .hero-panel {
      padding: 1.4rem;
    }

    .discipline-card-shell {
      padding: 1.4rem;
    }
  }

  /* Timeline: one lane per discipline, stages left to right (Done -> In progress -> Up next). */
  .timeline {
    display: grid;
    gap: 1.1rem;
  }

  .lane {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr);
    border: 1px solid rgba(151, 110, 51, 0.38);
    border-left: 3px solid var(--lane-accent);
    background:
      linear-gradient(90deg, var(--lane-glow), transparent 18%),
      linear-gradient(180deg, rgba(17, 13, 12, 0.92), rgba(10, 8, 8, 0.95));
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.32);
  }

  .lane-head {
    padding: 1.3rem 1.4rem;
    border-right: 1px solid rgba(151, 110, 51, 0.25);
  }

  .lane-head h2 {
    margin: 0;
    font-family: 'Cinzel', 'Times New Roman', serif;
    font-size: 1.35rem;
    color: #f5eee5;
  }

  .lane-focus {
    margin: 0.3rem 0 0;
    font-size: 0.85rem;
    color: var(--lane-accent);
  }

  .lane-lead {
    margin: 0.55rem 0 0;
    font-size: 0.8rem;
    color: rgba(231, 222, 214, 0.6);
  }

  .lane-track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 1.3rem 1.4rem;
    list-style: none;
  }

  /* The lane's line runs through the three stage dots. */
  .lane-track::before {
    content: '';
    position: absolute;
    left: 1.4rem;
    right: 1.4rem;
    top: calc(1.3rem + 0.45rem);
    height: 2px;
    background: linear-gradient(90deg, var(--lane-accent) 0 40%, rgba(214, 176, 106, 0.25) 70%, transparent);
  }

  .stage-title {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-family: 'Cinzel', 'Times New Roman', serif;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #f0e7db;
    /* Backing so the lane line stops at the label instead of striking through it. */
    width: fit-content;
    padding-right: 0.6rem;
    background: rgb(14, 11, 10);
  }

  .stage-dot {
    flex: none;
    width: 0.95rem;
    height: 0.95rem;
    border: 2px solid var(--lane-accent);
    border-radius: 50%;
    background: #0d0a09;
  }

  .stage-done .stage-dot {
    background: var(--lane-accent);
  }

  .stage-now .stage-dot {
    background: var(--lane-accent);
    box-shadow: 0 0 0 4px var(--lane-glow);
  }

  .stage-next .stage-dot {
    border-style: dashed;
  }

  .stage-count {
    color: rgba(214, 176, 106, 0.7);
  }

  .stage-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  .stage-items li {
    padding: 0.32rem 0.6rem;
    border: 1px solid rgba(151, 110, 51, 0.3);
    background: rgba(255, 255, 255, 0.03);
    font-size: 0.86rem;
    color: rgba(231, 222, 214, 0.86);
  }

  .stage-done .stage-items li {
    color: rgba(231, 222, 214, 0.62);
  }

  .stage-done .stage-items li::before {
    content: '\2713  ';
    color: var(--lane-accent);
  }

  .stage-now .stage-items li {
    border-color: var(--lane-accent);
    background: var(--lane-glow);
    color: #fff5e3;
  }

  .stage-next .stage-items li {
    border-style: dashed;
  }

  .item-eta {
    margin-left: 0.45rem;
    font-size: 0.74rem;
    color: var(--lane-accent);
  }

  .stage-empty {
    margin: 0.8rem 0 0;
    font-size: 0.84rem;
    font-style: italic;
    color: rgba(231, 222, 214, 0.45);
  }

  @media (max-width: 900px) {
    .lane {
      grid-template-columns: 1fr;
    }

    .lane-head {
      border-right: 0;
      border-bottom: 1px solid rgba(151, 110, 51, 0.25);
    }

    .lane-track {
      grid-template-columns: 1fr;
    }

    .lane-track::before {
      left: calc(1.4rem + 0.45rem - 1px);
      right: auto;
      top: 1.3rem;
      bottom: 1.3rem;
      width: 2px;
      height: auto;
      background: linear-gradient(180deg, var(--lane-accent) 0 40%, rgba(214, 176, 106, 0.25) 70%, transparent);
    }

    .stage-items {
      padding-left: 1.45rem;
    }

    .stage-empty {
      padding-left: 1.45rem;
    }
  }
</style>
