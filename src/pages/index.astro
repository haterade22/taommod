---
import Topbar from '../components/Topbar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { srcsetFor } from '../lib/responsive-image';
---

<BaseLayout
  title="Home"
  description="TAOM - Tales From the Age of Men: a Lord of the Rings total conversion mod for Mount & Blade II: Bannerlord. Factions, troop and lord database, downloads and news."
  hideNav={true}
  hideFooter={true}
  bodyClass="taom-home-body"
  mainClass="taom-home-main"
>
  <div class="home-page">
    <div class="home-background" aria-hidden="true">
      <!-- The video is pre-blurred and darkened (no CSS filters, which are slow on a playing video, especially in
           Firefox) and only 0.6 MB. It loads unless reduced-motion or data-saver is on; then the poster stays. -->
      <video
        class="home-background-video"
        muted
        loop
        playsinline
        preload="none"
        poster="/images/sauron-bg-poster.webp"
        data-src="/images/sauron-bg.mp4"
        data-home-video
      >
      </video>
      <div class="home-background-overlay"></div>
    </div>

    <Topbar />

    <main class="home-landing">
      <h1 class="visually-hidden">Tales from the Age of Men</h1>
      <div class="home-landing-glow" aria-hidden="true"></div>

      <div class="home-hero" aria-label="Tales from the Age of Men landing page">
        <img
          class="home-hero-logo"
          src="/images/logo.webp"
          srcset={srcsetFor('/images/logo.webp')}
          sizes="min(44rem, 90vw)"
          alt="Tales from the Age of Men"
          width="900"
          height="320"
          fetchpriority="high"
        />

        <div class="home-hero-copy">
          <p>Total Conversion Mod</p>
          <p>For Mount &amp; Blade II: Bannerlord</p>
        </div>

        <div class="home-hero-actions">
          <a class="home-download-button" href="/download/">Download</a>
          <a class="home-secondary-button" href="/database/">Browse Database</a>
        </div>
      </div>
    </main>

    <!-- TAOM main menu theme. Browsers only allow sound after the visitor has clicked or pressed a key, so the music
         starts then; the corner button mutes it, and the choice is remembered. -->
    <audio data-home-music loop preload="none" data-src="/audio/menu-theme.mp3"></audio>
    <button class="home-music-toggle" type="button" data-home-music-toggle aria-pressed="false" aria-label="Mute music">
      <svg class="icon-on" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"></path>
        <path
          d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"></path>
      </svg>
      <svg class="icon-off" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"></path>
        <path d="M16 9l5 6M21 9l-5 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
        ></path>
      </svg>
    </button>
  </div>
</BaseLayout>

<script is:inline>
  (() => {
    const startHomeVideo = () => {
      const video = document.querySelector('[data-home-video]');
      if (!video || video.src) return;

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const saveData = navigator.connection && navigator.connection.saveData;
      if (reducedMotion || saveData) return;

      video.src = video.dataset.src;
      video.play().catch(() => {});
    };

    if (!window.__taomHomeVideoBound) {
      window.__taomHomeVideoBound = true;
      document.addEventListener('astro:page-load', startHomeVideo);
    }

    startHomeVideo();
  })();

  (() => {
    const STORAGE_KEY = 'taom-home-music-muted';
    const readMuted = () => {
      try {
        return localStorage.getItem(STORAGE_KEY) === '1';
      } catch {
        return false;
      }
    };
    const saveMuted = (muted) => {
      try {
        localStorage.setItem(STORAGE_KEY, muted ? '1' : '0');
      } catch {
        /* storage blocked: the choice lasts for this visit only */
      }
    };

    const initHomeMusic = () => {
      const audio = document.querySelector('[data-home-music]');
      const toggle = document.querySelector('[data-home-music-toggle]');
      if (!audio || !toggle || audio.dataset.ready) return;
      audio.dataset.ready = '1';
      audio.volume = 0.35;

      let muted = readMuted();
      const waiting = new AbortController();

      const show = () => {
        toggle.setAttribute('aria-pressed', String(muted));
        toggle.setAttribute('aria-label', muted ? 'Play music' : 'Mute music');
        toggle.classList.toggle('is-muted', muted);
      };

      const play = () => {
        if (!audio.src) audio.src = audio.dataset.src;
        return audio.play();
      };

      // Browsers block sound until the visitor interacts, so if autoplay is refused, start on the first click or key.
      const startOnInteraction = () => {
        const start = (event) => {
          if (muted || toggle.contains(event.target)) return;
          waiting.abort();
          play().catch(() => {});
        };
        for (const type of ['pointerdown', 'keydown', 'touchstart']) {
          document.addEventListener(type, start, { signal: waiting.signal, passive: true });
        }
      };

      toggle.addEventListener('click', () => {
        muted = !muted;
        saveMuted(muted);
        show();
        if (muted) {
          audio.pause();
        } else {
          waiting.abort();
          play().catch(() => {});
        }
      });

      // Leaving the home page (the site swaps pages without a full reload) stops the music.
      document.addEventListener(
        'astro:before-swap',
        () => {
          waiting.abort();
          audio.pause();
        },
        { once: true },
      );

      show();
      if (!muted) play().catch(startOnInteraction);
    };

    if (!window.__taomHomeMusicBound) {
      window.__taomHomeMusicBound = true;
      document.addEventListener('astro:page-load', initHomeMusic);
    }

    initHomeMusic();
  })();
</script>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* The home page is one screen: hero fills the space between the top bar and the footer, so there is nothing
     to scroll unless the screen is too small for the content. */
  :global(body.taom-home-body) {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: #060505;
    color: #ece7e0;
  }

  :global(.taom-home-main) {
    display: flex;
    flex: 1 0 auto;
  }

  .home-page {
    flex: 1;
    position: relative;
    isolation: isolate;
    padding: 2rem;
    font-family: Georgia, 'Times New Roman', serif;
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .home-background {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: #050404;
  }

  .home-background-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 58%;
  }

  .home-background-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(8, 7, 6, 0.42), rgba(6, 5, 5, 0.74)),
      radial-gradient(circle at 50% 50%, rgba(0, 0, 0, 0.06), rgba(0, 0, 0, 0.48) 72%);
  }

  .topbar {
    position: sticky;
    top: 2rem;
    z-index: 100;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.75rem;
    padding: 1.15rem 1.6rem;
    border: 1px solid rgba(58, 48, 30, 0.7);
    background:
      linear-gradient(90deg, rgba(16, 12, 10, 0.97), rgba(9, 13, 10, 0.96) 45%, rgba(16, 11, 8, 0.97)),
      linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.42);
  }

  .brand {
    display: inline-grid;
    gap: 0;
    justify-items: center;
    color: #d19a33;
    text-align: center;
    text-transform: uppercase;
    line-height: 0.9;
  }

  .brand:hover {
    color: #f7f2ec;
    text-decoration: none;
  }

  .main-nav a,
  .side-link,
  .home-hero-copy p,
  .home-download-button,
  .home-secondary-button {
    font-family: 'Cinzel', 'Times New Roman', serif;
  }

  .main-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 1.1rem;
  }

  .main-nav a,
  .side-link {
    position: relative;
    padding: 0.35rem 0.35rem 0.5rem;
    color: #d19a33;
    font-size: 1rem;
    font-weight: 600;
    transition: color 180ms ease;
  }

  .main-nav a::after,
  .side-link::after {
    content: '';
    position: absolute;
    left: 0.35rem;
    right: 0.35rem;
    bottom: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(205, 153, 52, 0.88), transparent);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 180ms ease;
  }

  .main-nav a:hover,
  .main-nav a.is-active,
  .side-link:hover {
    color: #f7f2ec;
    text-decoration: none;
  }

  .main-nav a:hover::after,
  .main-nav a.is-active::after,
  .side-link:hover::after {
    transform: scaleX(1);
  }

  .side-link {
    color: #f7f2ec;
  }

  .home-landing {
    position: relative;
    display: grid;
    place-items: center;
    padding: 2rem 1rem;
  }

  .home-landing-glow {
    position: absolute;
    inset: auto 0 10% 0;
    height: 18rem;
    /* closest-side: the glow fades to nothing before the box edge, so no hard-edged band shows (no blur filter needed). */
    background: radial-gradient(ellipse closest-side, rgba(191, 125, 56, 0.1), transparent);
    pointer-events: none;
  }

  .home-hero {
    position: relative;
    width: min(100%, 72rem);
    display: grid;
    justify-items: center;
    gap: 1.75rem;
    text-align: center;
  }

  .home-hero-logo {
    display: block;
    width: min(44rem, 90vw);
    height: auto;
  }

  .home-hero-copy {
    display: grid;
    gap: 0.75rem;
  }

  .home-hero-copy p {
    margin: 0;
    font-size: clamp(1.2rem, 2vw, 1.95rem);
    font-weight: 500;
    letter-spacing: 0.24em;
    line-height: 1.12;
    text-transform: uppercase;
    color: rgba(236, 231, 224, 0.94);
    text-shadow:
      0 2px 0 rgba(0, 0, 0, 0.28),
      0 2px 3px rgba(0, 0, 0, 0.26);
  }

  .home-hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .home-download-button,
  .home-secondary-button {
    display: inline-grid;
    place-items: center;
    min-width: 15rem;
    padding: 1.15rem 2rem;
    font-size: clamp(1rem, 1.2vw, 1.25rem);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.45);
    transition:
      transform 180ms ease,
      filter 180ms ease,
      border-color 180ms ease;
  }

  .home-download-button {
    color: #ece7e0;
    background: rgba(57, 41, 32, 0.94);
    border: 1px solid rgba(234, 221, 200, 0.18);
  }

  .home-secondary-button {
    color: #d6c9ba;
    background: rgba(19, 15, 13, 0.72);
    border: 1px solid rgba(128, 101, 62, 0.4);
  }

  .home-download-button:hover,
  .home-secondary-button:hover {
    color: #fff3de;
    text-decoration: none;
    transform: translateY(-2px);
    filter: brightness(1.06);
    border-color: rgba(234, 221, 200, 0.28);
  }

  /* Bottom-left: the cookie notice uses the bottom-right corner. */
  .home-music-toggle {
    position: fixed;
    left: 1.25rem;
    bottom: 1.25rem;
    z-index: 90;
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    padding: 0;
    color: #d19a33;
    background: rgba(16, 12, 10, 0.88);
    border: 1px solid rgba(128, 101, 62, 0.55);
    border-radius: 50%;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.45);
    cursor: pointer;
    transition:
      color 180ms ease,
      border-color 180ms ease;
  }

  .home-music-toggle:hover,
  .home-music-toggle:focus-visible {
    color: #f7f2ec;
    border-color: rgba(234, 221, 200, 0.4);
  }

  .home-music-toggle:focus-visible {
    outline: 2px solid #d19a33;
    outline-offset: 3px;
  }

  .home-music-toggle .icon-off,
  .home-music-toggle.is-muted .icon-on {
    display: none;
  }

  .home-music-toggle.is-muted .icon-off {
    display: block;
  }

  /* Phones: the cookie notice is a full-width strip at the bottom, so on the home page it starts right of the
     music button and both stay visible. */
  @media (max-width: 640px) {
    .home-music-toggle {
      left: 0.75rem;
      bottom: 0.75rem;
    }

    :global(body.taom-home-body .cookie-notice) {
      width: calc(100vw - 4.75rem);
    }
  }

  @media (max-width: 980px) {
    .topbar {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    .brand {
      justify-items: start;
      text-align: left;
    }

    .main-nav {
      justify-content: flex-start;
    }
  }

  @media (max-width: 760px) {
    .home-page {
      padding: 1rem;
    }

    .topbar {
      top: 1rem;
      gap: 1rem;
      padding: 1rem;
    }

    .main-nav {
      gap: 0.6rem 0.9rem;
    }

    .main-nav a,
    .side-link {
      font-size: 0.92rem;
    }

    .home-landing {
      min-height: auto;
      padding: 3.5rem 0.5rem 4rem;
    }

    .home-hero-copy p {
      letter-spacing: 0.14em;
    }

    .home-download-button,
    .home-secondary-button {
      width: 100%;
      min-width: 0;
    }
  }
</style>
