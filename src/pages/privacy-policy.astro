---
import Topbar from '../components/Topbar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Privacy Policy"
  description="How TAOM handles privacy, on-site data collection, and third-party services."
  hideNav={true}
  hideFooter={true}
  bodyClass="taom-policy-body"
  mainClass="taom-policy-main"
>
  <div class="policy-page">
    <Topbar />

    <main class="page-shell">
      <section class="hero-panel">
        <div class="hero-copy">
          <p class="eyebrow">Privacy Policy</p>
          <h1>How privacy works on TAOM today.</h1>
          <p class="intro-copy">
            TAOM is a static site with a very small data footprint. Based on the current codebase, the site does not run
            analytics, ad tracking, user accounts, or on-site contact forms. Most browsing can happen without directly
            providing personal information to the site itself.
          </p>
        </div>

        <aside class="hero-summary-card">
          <p class="card-kicker">At a Glance</p>
          <div class="summary-list">
            <div class="summary-item">
              <span class="summary-label">On-site collection</span>
              <strong>No forms, accounts, or newsletter signup</strong>
            </div>
            <div class="summary-item">
              <span class="summary-label">Usage tracking</span>
              <strong>No analytics stack found in site code</strong>
            </div>
            <div class="summary-item">
              <span class="summary-label">Third parties</span>
              <strong>External services may process data under their own policies</strong>
            </div>
          </div>
        </aside>
      </section>

      <section class="policy-grid">
        <article class="policy-card policy-card-featured">
          <p class="card-kicker">Information TAOM Collects</p>
          <h2>Very little is collected directly by the website</h2>
          <p>
            Based on the current implementation, TAOM does not directly collect names, email addresses, account
            profiles, payment information, or support messages through the website itself. There is no on-site account
            system or submission form in the current pages.
          </p>
        </article>

        <article class="policy-card">
          <p class="card-kicker">Browser Data</p>
          <h2>Standard technical request data may still exist</h2>
          <p>
            As with any publicly accessible site, the hosting and delivery layer may process technical request details
            such as IP address, browser details, timestamps, or referrer information in order to serve pages and assets.
          </p>
        </article>

        <article class="policy-card">
          <p class="card-kicker">Third-Party Platforms</p>
          <h2>External links and media have their own privacy rules</h2>
          <p>
            TAOM links out to services such as Patreon, Discord, YouTube, Nexus Mods, and ModDB, and some mirrored news
            content may load Patreon-hosted images. If you interact with those services, they may collect and process
            personal data according to their own privacy policies.
          </p>
        </article>

        <article class="policy-card">
          <p class="card-kicker">Cookies and Storage</p>
          <h2>See the cookie policy for the browser-storage details</h2>
          <p>
            The site currently uses a temporary browser session flag so the cookie notice does not keep reappearing
            during the same browsing session. For the storage-specific details, see the cookie policy.
          </p>
        </article>

        <article class="policy-card policy-card-wide">
          <p class="card-kicker">If You Contact the Team Elsewhere</p>
          <h2>Privacy depends on the platform you use</h2>
          <p>
            If you contact the TAOM team through Discord, Patreon, YouTube comments, ModDB, Nexus Mods, or any other
            external platform, your information will be handled under that platform's systems and policies rather than
            through the TAOM website itself.
          </p>
          <div class="policy-actions">
            <a class="policy-action policy-action-primary" href="/cookie-policy">Read Cookie Policy</a>
            <a class="policy-action policy-action-secondary" href="/community">Open Community</a>
          </div>
        </article>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  :global(body.taom-policy-body) {
    min-height: 100vh;
    background:
      linear-gradient(180deg, rgba(7, 5, 5, 0.64), rgba(7, 5, 5, 0.96)),
      radial-gradient(circle at 16% 18%, rgba(128, 72, 34, 0.18), transparent 25%),
      radial-gradient(circle at 84% 14%, rgba(98, 44, 26, 0.16), transparent 24%),
      linear-gradient(180deg, #17100e 0%, #0d0908 48%, #080606 100%);
    color: #ece4db;
  }

  :global(body.taom-policy-body::before) {
    content: '';
    position: fixed;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(15, 10, 9, 0.3), rgba(8, 6, 6, 0.82)),
      url('/images/hero-bg.jpg') center top / cover no-repeat;
    opacity: 0.2;
    pointer-events: none;
    z-index: -2;
  }

  :global(.taom-policy-main) {
    display: block;
  }

  .policy-page {
    min-height: 100vh;
    padding: 2rem;
    font-family: Georgia, 'Times New Roman', serif;
  }

  .page-shell {
    width: min(100%, 76rem);
    margin: 0 auto;
    padding: 4rem 0 5rem;
    display: grid;
    gap: 1.5rem;
  }

  .hero-panel {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.8fr);
    gap: 1.5rem;
  }

  .hero-copy,
  .hero-summary-card,
  .policy-card {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(151, 110, 51, 0.44);
    background:
      linear-gradient(180deg, rgba(17, 13, 12, 0.88), rgba(10, 8, 8, 0.92)),
      linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.34);
  }

  .hero-copy::before,
  .hero-summary-card::before,
  .policy-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(214, 168, 89, 0.08),
      transparent 40%,
      transparent 70%,
      rgba(214, 168, 89, 0.04)
    );
    pointer-events: none;
  }

  .hero-copy {
    background:
      linear-gradient(180deg, rgba(12, 9, 8, 0.42), rgba(8, 7, 7, 0.7)),
      url('/images/community/block-background.png') center / cover no-repeat;
    padding: 3rem;
  }

  .hero-copy::before {
    background: url('/images/community/block-overlay.png') center / 100% 100% no-repeat;
  }

  .hero-copy::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/images/community/block-border.png') center / 100% 100% no-repeat;
    pointer-events: none;
    z-index: 2;
  }

  .hero-copy > * {
    position: relative;
    z-index: 3;
  }

  .hero-summary-card,
  .policy-card {
    padding: 2rem;
  }

  .eyebrow,
  .card-kicker,
  .summary-label,
  .policy-action {
    font-family: 'Cinzel', 'Times New Roman', serif;
  }

  .eyebrow,
  .card-kicker {
    margin: 0 0 0.8rem;
    font-size: 0.78rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: rgba(214, 176, 106, 0.84);
  }

  .hero-copy h1,
  .policy-card h2 {
    margin: 0;
    color: #f5eee5;
  }

  .hero-copy h1 {
    max-width: 13ch;
    font-size: clamp(2.4rem, 4vw, 4.2rem);
    line-height: 0.95;
  }

  .intro-copy,
  .policy-card p,
  .policy-card li,
  .summary-item strong {
    color: rgba(231, 222, 214, 0.82);
  }

  .intro-copy {
    max-width: 44rem;
    margin: 1.15rem 0 0;
    font-size: 1.04rem;
    line-height: 1.7;
  }

  .summary-list {
    display: grid;
    gap: 0.9rem;
    margin-top: 1rem;
  }

  .summary-item {
    display: grid;
    gap: 0.32rem;
    padding: 1rem 1.05rem;
    border: 1px solid rgba(151, 110, 51, 0.32);
    background:
      linear-gradient(180deg, rgba(20, 14, 12, 0.9), rgba(10, 8, 8, 0.92)),
      linear-gradient(135deg, rgba(214, 168, 89, 0.05), transparent 46%);
  }

  .summary-label {
    color: rgba(214, 176, 106, 0.82);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .policy-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .policy-card h2 {
    font-size: clamp(1.35rem, 2vw, 1.9rem);
    line-height: 1.05;
  }

  .policy-card p {
    margin: 0.95rem 0 0;
    line-height: 1.7;
  }

  .policy-card-featured,
  .policy-card-wide {
    grid-column: 1 / -1;
  }

  .policy-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.35rem;
  }

  .policy-action {
    display: inline-grid;
    place-items: center;
    min-width: 12rem;
    padding: 0.9rem 1.2rem;
    border: 1px solid rgba(205, 153, 52, 0.46);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background 180ms ease;
  }

  .policy-action:hover {
    text-decoration: none;
    transform: translateY(-1px);
    border-color: rgba(205, 153, 52, 0.86);
  }

  .policy-action-primary {
    color: #fff5e3;
    background:
      linear-gradient(180deg, rgba(70, 50, 39, 0.92), rgba(43, 31, 25, 0.96)),
      radial-gradient(circle at top, rgba(255, 239, 193, 0.08), transparent 56%);
  }

  .policy-action-secondary {
    color: #d9cdbd;
    background: rgba(19, 15, 13, 0.72);
    border-color: rgba(128, 101, 62, 0.4);
  }

  @media (max-width: 1080px) {
    .hero-panel,
    .policy-grid {
      grid-template-columns: 1fr;
    }

    .policy-card-featured,
    .policy-card-wide {
      grid-column: auto;
    }
  }

  @media (max-width: 760px) {
    .policy-page {
      padding: 1rem;
    }

    .page-shell {
      padding: 2.5rem 0 3.5rem;
    }

    .hero-copy,
    .hero-summary-card,
    .policy-card {
      padding: 1.5rem;
    }

    .hero-copy h1 {
      max-width: none;
      font-size: clamp(2rem, 10vw, 2.8rem);
    }

    .policy-action {
      width: 100%;
      min-width: 0;
    }
  }
</style>
